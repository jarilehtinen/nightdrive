#!/bin/bash
# deck-open [search QUERY | player | restart | quit | log]: Deck's window (app/, a Quickshell config of its own) over the
# player, `deck serve`, which is started first if no Deck runs. The window only talks to the player, so closing it leaves
# the music playing. The launcher, the bar, Hyper+M and F8 (hypr/scripts/media-play) run it as ~/.local/bin/deck-open.
# A Deck built before `deck serve` (nightdrive update builds it again) opens in a terminal as before.
set -u

APP_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")   # the plugin's folder
QS_DIR=$APP_DIR/app
DECK=$HOME/.local/bin/deck
RUNTIME=${XDG_RUNTIME_DIR:-/tmp}/deck
SERVE_LOG=$HOME/.cache/deck/serve.log                   # what `deck serve` says before its own log (deck.log) opens
START_WAIT=50                                           # × 0.2 s for the player to answer

# A Deck plays: its state file's pid lives (a killed one leaves the file behind)
player_running() {
  local pid
  pid=$(jq -r '.pid // empty' "$RUNTIME/state.json" 2>/dev/null)
  [[ -n $pid && -d /proc/$pid ]]
}

start_player() {
  player_running && return 0
  mkdir -p "$(dirname "$SERVE_LOG")"
  setsid -f "$DECK" serve >"$SERVE_LOG" 2>&1 </dev/null
  for _ in $(seq "$START_WAIT"); do
    player_running && return 0
    sleep 0.2
  done
  # Still starting (the first sign-in waits for the browser), or it stopped: then its last words say why
  pgrep -xf "$DECK serve" >/dev/null && return 0
  notify-send -a Deck "Deck didn't start" "$(tail -n 1 "$SERVE_LOG" 2>/dev/null)"
  return 1
}

running() { qs list -p "$QS_DIR" 2>/dev/null | grep -q 'Process ID'; }
pid() { qs list -p "$QS_DIR" 2>/dev/null | awk '/Process ID/ { print $3; exit }'; }
start() { setsid -f qs -p "$QS_DIR" >/dev/null 2>&1; }
stop() {
  running || return 0
  qs kill -p "$QS_DIR" >/dev/null 2>&1
  for _ in $(seq 10); do running || return 0; sleep 0.1; done
}
# A window just started answers over IPC once it has loaded (3 s at most)
ready() {
  for _ in $(seq 30); do
    qs ipc -p "$QS_DIR" show 2>/dev/null | grep -q 'target deck' && return 0
    sleep 0.1
  done
  return 1
}
# Brings the open window forward; without one (closed while Quickshell stayed), starts again
focus() {
  local addr
  addr=$(hyprctl -j clients | jq -r --argjson pid "$(pid)" '[.[] | select(.pid == $pid and .title == "Deck")] | first | .address // empty')
  if [[ -n $addr ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
  else
    stop; start
  fi
}
open_window() { if running; then focus; else start; fi; }

# The old way, for a Deck without `deck serve`: Deck in a terminal window of its own
if ! "$DECK" --help 2>/dev/null | grep -q serve; then
  [[ ${1:-open} == open ]] || exit 1
  exec "$HOME/.config/hypr/scripts/launch-or-focus" '^(sh\.nightdrive\.)?deck$' \
    "$HOME/.config/hypr/scripts/terminal" --class deck -- "$DECK"
fi

case ${1:-open} in
  open)
    start_player || exit 1
    # Autostart's background apps start hidden: the player, not the window
    [[ -n ${LAUNCH_HIDDEN:-} ]] || open_window
    ;;
  player)  start_player ;;
  search)
    start_player || exit 1
    if running; then focus; else start; ready; fi
    qs ipc -p "$QS_DIR" call deck search "${*:2}" >/dev/null
    ;;
  restart) stop; start ;;
  quit)    stop; "$DECK" ctl quit 2>/dev/null ;;
  log)     running || { echo "Deck's window is not open." >&2; exit 1; }; qs log -p "$QS_DIR" -f ;;
  *)       echo "usage: deck-open [search QUERY | player | restart | quit | log]" >&2; exit 2 ;;
esac
