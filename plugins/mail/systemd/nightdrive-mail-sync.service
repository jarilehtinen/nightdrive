# Mail's sync (plugins/mail): fetches every account in ~/.config/isyncrc and indexes the new mail, whose post-new hook
# sends the notifications (`nightmail notify`). Run by nightdrive-mail-sync.timer and `nightmail sync`.
[Unit]
Description=Nightdrive Mail: fetch mail (mbsync) and index it (notmuch)
After=network-online.target
# Mail is installed before its account is set up (its first start offers that): nothing to fetch until then
ConditionPathExists=%h/.config/isyncrc

[Service]
Type=oneshot
# Skip the round while the login keyring is locked (an autologin start before the lock's password): a PassCmd's
# secret-tool would otherwise pop up gnome-keyring's own password prompt. Without a keyring the round runs. Not a bare
# `busctl get-property`: a read as a connection's first message can abort gnome-keyring (lib/keyring.py says why).
ExecCondition=/bin/sh -c '! %h/.local/bin/nightmail keyring-locked'
ExecStart=/usr/bin/mbsync -a -q
ExecStartPost=/usr/bin/notmuch new --quiet
