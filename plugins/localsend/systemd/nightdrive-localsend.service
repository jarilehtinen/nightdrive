# LocalSend receiver (plugins/localsend, bin/localsend). Off until turned on (localsend enable, its installer).
[Unit]
Description=Nightdrive LocalSend receiver
PartOf=nightdrive-session.target
After=nightdrive-session.target

[Service]
ExecStart=%h/.local/bin/localsend run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=nightdrive-session.target
