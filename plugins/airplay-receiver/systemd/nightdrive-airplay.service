# AirPlay Receiver (plugins/airplay-receiver, bin/airplay-receiver). Off until turned on (its install.sh, airplay-receiver enable).
# The ⌘W crash is restarted by airplay-receiver run itself; Restart=always covers anything else.
[Unit]
Description=Nightdrive AirPlay Receiver (UxPlay)
PartOf=nightdrive-session.target
After=nightdrive-session.target

[Service]
ExecStart=%h/.local/bin/airplay-receiver run
Restart=always
RestartSec=1

[Install]
WantedBy=nightdrive-session.target
