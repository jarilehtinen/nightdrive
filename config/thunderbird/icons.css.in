/* Lucide icons (lucide-static 0.460.0) for Thunderbird's --icon-* variables. Generated by link.sh from icons.css.in:
   url() needs an absolute file:// path (a relative one resolves against Thunderbird's own stylesheet). */
:root {
  --icon-reply: url("file://@DIR@/icons/lucide/reply.svg") !important;
  --icon-reply-all: url("file://@DIR@/icons/lucide/reply-all.svg") !important;
  --icon-forward: url("file://@DIR@/icons/lucide/forward.svg") !important;
  --icon-archive: url("file://@DIR@/icons/lucide/archive.svg") !important;
  --icon-spam: url("file://@DIR@/icons/lucide/octagon-alert.svg") !important;
  --icon-trash: url("file://@DIR@/icons/lucide/trash-2.svg") !important;
  --icon-inbox: url("file://@DIR@/icons/lucide/inbox.svg") !important;
  --icon-draft: url("file://@DIR@/icons/lucide/file-pen-line.svg") !important;
  --icon-sent: url("file://@DIR@/icons/lucide/send.svg") !important;
  --icon-folder: url("file://@DIR@/icons/lucide/folder.svg") !important;
  --icon-outbox: url("file://@DIR@/icons/lucide/mail-up.svg") !important;
  --icon-folder-filter: url("file://@DIR@/icons/lucide/folder-search.svg") !important;
  --icon-mail: url("file://@DIR@/icons/lucide/mail.svg") !important;
  --icon-mail-secure: url("file://@DIR@/icons/lucide/mail.svg") !important;
  --icon-app-menu: url("file://@DIR@/icons/lucide/menu.svg") !important;
}
