{
  "manifest_version": 2,
  "name": "Folder Pane Toggle",
  "description": "Jokela Night: show/hide the folder pane from a top bar button.",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": { "id": "folderpane-toggle@jokela-night", "strict_min_version": "128.0" }
  },
  "background": { "scripts": ["background.js"] },
  "browser_action": {
    "default_title": "Kansiopaneeli",
    "default_icon": "sidebar.svg",
    "allowed_spaces": ["mail"]
  }
}
