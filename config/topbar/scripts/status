#!/bin/bash
# Top bar module states. Prints one line of JSON {icon, text, class} (format: modules.jsonc); Quickshell's bar runs this
# per module on its interval, and `qs ipc call bar refresh` makes it run every module at once.
# Usage: status <name>   (the names in modules.jsonc; a private overlay's modules come from status.local)
kind=${1:?usage: status <name>}

# The machine's own battery as UPower names it (MacBook: battery_macsmc_battery). Found in /sys/class/power_supply,
# skipping Bluetooth mice and keyboards (scope Device). Empty on a desktop: the module stays hidden.
battery() {
  local d
  for d in /sys/class/power_supply/*; do
    [[ $(cat "$d/type" 2>/dev/null) == Battery && $(cat "$d/scope" 2>/dev/null) != Device ]] || continue
    local n=${d##*/}; echo "/org/freedesktop/UPower/devices/battery_${n//-/_}"; return
  done
}

emit() {  # emit ICON TEXT [CLASS]   (no icon and no text = hidden)
  jq -nc --arg i "$1" --arg t "$2" --arg c "${3:-}" '{icon: $i, text: $t, class: $c}'
}

case $kind in
  wifi)
    if [[ $(nmcli radio wifi 2>/dev/null) != enabled ]]; then emit wifi-off "" off; exit; fi
    if nmcli -t -f ACTIVE device wifi list --rescan no 2>/dev/null | grep -q '^yes'; then emit wifi ""
    # Connecting (also after waking up): the arcs fill up one by one (BarModule.qml animates icons separated by |)
    elif nmcli -t -f TYPE,STATE device 2>/dev/null | grep -q '^wifi:connecting'; then emit "wifi-zero|wifi-low|wifi-high|wifi" ""
    elif nmcli -t -f TYPE,STATE device 2>/dev/null | grep -q '^ethernet:connected'; then emit cable ""
    else emit wifi-off "" off; fi ;;
  bluetooth)
    # Without an adapter (a VM) bluetooth.service is stopped and bluetoothctl would wait forever
    if ! systemctl is-active -q bluetooth || ! timeout 2 bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then emit bluetooth-off "" off; exit; fi
    if [[ -n $(bluetoothctl devices Connected 2>/dev/null) ]]; then emit bluetooth-connected ""; else emit bluetooth ""; fi ;;
  volume)
    v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    pct=$(awk '{printf "%d", $2*100+0.5}' <<<"$v")
    if grep -q MUTED <<<"$v"; then emit volume-x "" off
    elif (( pct < 50 )); then emit volume-1 ""
    else emit volume-2 ""; fi ;;
  headphones)
    # Shown only while Bluetooth headphones are connected, never dimmed (the EasyEffects EQ state is in the menu).
    pactl list short sinks 2>/dev/null | grep -q bluez_output || { emit "" ""; exit; }
    emit headphones "" ;;
  display)
    # Brightness, night light, Screen Mirroring and scale are in the menu (DisplayMenu.qml). Mirroring: highlighted
    # screen-share icon; otherwise a dot on the monitor while the night light is on
    if [[ -x ~/.local/bin/doubletake-ctl && $(~/.local/bin/doubletake-ctl status 2>/dev/null | jq -r .state) == streaming ]]; then emit screen-share "" active
    elif [[ $(~/.config/hypr/scripts/nightlight status) == on ]]; then emit monitor-dot ""; else emit monitor ""; fi ;;
  battery)
    dev=$(battery); [[ -z $dev ]] && { emit "" ""; exit; }
    info=$(upower -i "$dev" 2>/dev/null)
    pct=$(grep -oP 'percentage:\s*\K[0-9]+' <<<"$info"); st=$(grep -oP 'state:\s*\K\S+' <<<"$info")
    cls=
    if [[ $st == charging ]]; then icon=battery-charging
    else
      (( pct <= 10 )) && cls=critical || { (( pct <= 20 )) && cls=warning; }
      if (( pct < 40 )); then icon=battery-low; elif (( pct < 60 )); then icon=battery-medium; else icon=battery-full; fi
    fi
    emit "$icon" "$pct%" "$cls" ;;
  deck)
    # Dimmed when Deck isn't running or has nothing loaded; highlighted while playing
    f="${XDG_RUNTIME_DIR:-/tmp}/deck/state.json"
    pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)
    if [[ -z $pid || ! -d /proc/$pid ]] || [[ $(jq -c '.info' "$f") == null ]]; then emit music "" off; exit; fi
    if [[ $(jq -r .info.playing "$f") == true ]]; then emit music "" active; else emit music ""; fi ;;
  claude)
    u=$(~/.config/topbar/scripts/claude-usage)
    sess=$(jq -r '(.windows // [] | map(select(.key == "session")) | first // {}).percent // -1' <<<"$u")
    if (( sess < 0 )); then emit gauge "" off; exit; fi
    # gauge@N: the needle points at the usage (TopBar.qml draws it)
    # The colour follows the 5 h window only, not the week
    if (( sess > 95 )); then cls=critical; elif (( sess > 90 )); then cls=warning; else cls=; fi
    emit "gauge@$sess" "$sess%" "$cls" ;;
  system)
    IFS=$'\t' read -r _ _ cls < <(~/.config/topbar/scripts/sysinfo bar)
    [[ $cls == high ]] && cls=critical
    emit cpu "" "$cls" ;;
  tailscale)
    if [[ $(tailscale status --json 2>/dev/null | jq -r '.BackendState // empty') == Running ]]; then emit tailscale ""
    else emit tailscale-off ""; fi ;;
  calendar)
    emit "" "$(~/.config/topbar/scripts/clock)" ;;
  notifications)
    emit menu "" ;;
  *)  # modules of a private overlay: status.local has its own case for them and can use emit
    [[ -f ~/.config/topbar/status.local ]] && source ~/.config/topbar/status.local ;;
esac
