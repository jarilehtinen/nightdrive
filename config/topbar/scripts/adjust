#!/usr/bin/env python3
# Top bar sizes and vertical positions (adjust.conf + a private overlay's local.adjust.conf): `nightdrive topbar adjust`.
# A terminal UI: pick a row, change its size / position a pixel at a time. Every change is saved at once and the bar
# (Quickshell, which watches the files) redraws immediately. Modules without a row of their own are listed too
# (with the `icon` defaults); changing one adds its row.
import curses, json, os, sys

TOP = os.path.expanduser("~/.config/topbar")
CONF, LOCAL_CONF = os.path.join(TOP, "adjust.conf"), os.path.join(TOP, "local.adjust.conf")
MODULES, LOCAL_MODULES = os.path.join(TOP, "modules.jsonc"), os.path.join(TOP, "local.modules.jsonc")


def fmt(v):
    s = ("%.2f" % v).rstrip("0").rstrip(".")
    return "0" if s == "-0" else s


def modules(path):
    try:
        text = "\n".join(l for l in open(path).read().split("\n") if not l.lstrip().startswith("//"))
        return [m["name"] for m in json.loads(text)]
    except (OSError, ValueError, KeyError):
        return []


class Row:
    def __init__(self, path, idx, el, size, y):
        self.path, self.idx, self.el = path, idx, el      # idx None = not in the file yet
        self.size, self.y = float(size), float(y)
        self.size0, self.y0 = self.size, self.y


def load():
    rows, lines = [], {}
    for p in (CONF, LOCAL_CONF):
        if not os.path.exists(p):
            continue
        lines[p] = open(p).read().split("\n")
        for i, line in enumerate(lines[p]):
            f = line.split("#", 1)[0].split()
            if len(f) >= 3:
                rows.append(Row(p, i, f[0], f[1], f[2]))
    have = {r.el for r in rows}
    icon = next((r for r in rows if r.el == "icon"), Row(CONF, None, "icon", 16, 0))
    local, public = modules(LOCAL_MODULES), modules(MODULES)
    for name in local + public:
        if name not in have and name != "calendar":      # calendar is text only
            p = LOCAL_CONF if name in local and LOCAL_CONF in lines else CONF
            rows.append(Row(p, None, name, icon.size, icon.y))
    order = ["text", "workspaces", "icon"] + local + public
    rows.sort(key=lambda r: order.index(r.el) if r.el in order else len(order))
    return rows, lines


def save(rows, lines):
    for p in lines:
        for r in rows:
            if r.path != p or (r.idx is None and r.size == r.size0 and r.y == r.y0):
                continue
            row = f"{r.el:<18}{fmt(r.size):<7}{fmt(r.y)}"
            if r.idx is None:
                while lines[p] and lines[p][-1] == "":
                    lines[p].pop()
                lines[p] += [row, ""]
                r.idx = len(lines[p]) - 2
            else:
                lines[p][r.idx] = row
        real = os.path.realpath(p)      # local.adjust.conf is a link into the overlay
        with open(real + ".tmp", "w") as f:
            f.write("\n".join(lines[p]))
        os.replace(real + ".tmp", real)


HELP = "↑↓ row   ←→ / a d size   w s up/down   A D W S ½ px   r reset row   R reset all   q quit"


def ui(scr, rows, lines):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_MAGENTA, -1)
    curses.init_pair(2, curses.COLOR_YELLOW, -1)
    sel, msg = 0, ""
    keys = {curses.KEY_LEFT: (-1, 0), ord("a"): (-1, 0), ord("-"): (-1, 0),
            curses.KEY_RIGHT: (1, 0), ord("d"): (1, 0), ord("+"): (1, 0),
            ord("A"): (-0.5, 0), ord("D"): (0.5, 0),
            ord("w"): (0, -1), ord("s"): (0, 1), ord("W"): (0, -0.5), ord("S"): (0, 0.5)}
    while True:
        scr.erase()
        h, w = scr.getmaxyx()
        put = lambda y, x, s, a=0: y < h and scr.addnstr(y, x, s, max(0, w - x - 1), a)
        put(0, 2, "Top bar adjust", curses.A_BOLD | curses.color_pair(1))
        put(1, 2, "size and y in px (y + = lower); saved to adjust.conf as you go", curses.A_DIM)
        put(3, 4, f"{'element':<18}{'size':>7}{'y':>8}", curses.A_DIM)
        for i, r in enumerate(rows[:max(0, h - 7)]):
            changed = r.size != r.size0 or r.y != r.y0
            line = f"{r.el:<18}{fmt(r.size):>7}{fmt(r.y):>8}"
            if changed:
                line += f"   (was {fmt(r.size0)} / {fmt(r.y0)})"
            elif r.idx is None:
                line += "   (default)"
            attr = (curses.A_REVERSE if i == sel else 0) | (curses.color_pair(2) if changed else 0)
            put(4 + i, 2, ("› " if i == sel else "  ") + line, attr)
        put(h - 2, 2, msg, curses.A_DIM)
        put(h - 1, 2, HELP, curses.A_DIM)
        scr.refresh()

        k = scr.getch()
        r = rows[sel]
        if k in (curses.KEY_UP, ord("k")):
            sel = (sel - 1) % len(rows)
        elif k in (curses.KEY_DOWN, ord("j")):
            sel = (sel + 1) % len(rows)
        elif k in keys:
            ds, dy = keys[k]
            r.size = max(1, round(r.size + ds, 2))
            r.y = round(r.y + dy, 2)
            save(rows, lines)
            msg = f"{r.el}: size {fmt(r.size)}, y {fmt(r.y)}"
        elif k == ord("r"):
            r.size, r.y = r.size0, r.y0
            save(rows, lines)
            msg = f"{r.el} reset"
        elif k == ord("R"):
            for x in rows:
                x.size, x.y = x.size0, x.y0
            save(rows, lines)
            msg = "all rows reset"
        elif k in (ord("q"), 27):
            return


def main():
    if len(sys.argv) > 1:
        sys.exit("usage: adjust   (no arguments: a terminal UI)")
    rows, lines = load()
    if CONF not in lines:
        sys.exit(f"missing {CONF}")
    curses.wrapper(ui, rows, lines)
    changed = [r for r in rows if r.size != r.size0 or r.y != r.y0]
    for r in changed:
        print(f"{r.el}: size {fmt(r.size0)} → {fmt(r.size)}, y {fmt(r.y0)} → {fmt(r.y)}")
    print("Saved in adjust.conf." if changed else "No changes.")


main()
