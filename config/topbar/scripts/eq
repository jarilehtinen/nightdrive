#!/bin/bash
# Headphone EQ (EasyEffects). Presets in ~/.local/share/easyeffects/output (Off = no effects):
#   "<headphones> · <style>[ · <mode>]"  per headphones, made by config/easyeffects/build-presets from AutoEq measurements;
#                                       <headphones> is part of the Bluetooth name (e.g. "VMK25", "AirPods Pro"), <mode> a
#                                       listening mode other than noise cancelling (e.g. Transparency, Passive)
#   "<style>"                           the generic ones (config/easyeffects/output) and any made in EasyEffects
# The menu shows styles only (Neutral, Bass, …): the connected headphones' own, else the generic ones. Headphones measured
# in several listening modes get them listed in the menu; the picked one is remembered per headphones.
# The chosen preset is saved as the headphones' autoload profile, so EasyEffects always loads it when the headphones
# connect, and the fallback preset Off for other devices (speakers).
# Usage: eq current | list | info | set <style> | toggle | anc <mode> | disconnect
#        (info = JSON for the Quickshell headphones menu)
dir=~/.local/share/easyeffects
last=~/.local/state/eq-last          # last style that was on (toggle restores it)
ancdir=~/.local/state/nightdrive/anc # <sink>: the listening mode picked in the menu (none: Noise cancelling)
# Headphones that tell their mode and take commands (Sony, hypr/scripts/sony-anc): the mode is read from them instead
live=${XDG_RUNTIME_DIR:-/tmp}/nightdrive/anc          # <MAC>: the mode now, while sony-anc has the headphones
livesock=${XDG_RUNTIME_DIR:-/tmp}/nightdrive/sony-anc.sock

sink_name() { pactl list short sinks 2>/dev/null | awk '$2 ~ /^bluez_output/ {print $2; exit}'; }
description() { pactl -f json list sinks 2>/dev/null | jq -r --arg s "$1" '.[] | select(.name == $s) | .description'; }
autoload_file() {   # EasyEffects: autoload/output/<node.name>:<active port description>.json
  local route
  route=$(pactl -f json list sinks 2>/dev/null | jq -r --arg s "$1" '.[] | select(.name == $s) | .active_port as $a | .ports[] | select(.name == $a) | .description')
  echo "$dir/autoload/output/$1:${route//\//_}.json"
}
presets() { for f in "$dir"/output/*.json; do basename "$f" .json; done; }
# The headphones' own preset prefix: the longest "<name> · " whose name is part of the Bluetooth name (empty: none)
headphones_key() {
  local desc best="" k
  desc=$(description "$1")
  while read -r k; do
    [[ -n $k && ${desc,,} == *"${k,,}"* && ${#k} -gt ${#best} ]] && best=$k
  done < <(presets | grep -F ' · ' | sed 's/ · .*//' | sort -u)
  echo "$best"
}
mac_of() { sed -E 's/^bluez_output\.([0-9A-F_]+).*/\1/; s/_/:/g' <<<"$1"; }
anc_mode() { cat "$live/$(mac_of "$1")" 2>/dev/null || cat "$ancdir/$1" 2>/dev/null || echo "Noise cancelling"; }
# The headphones' listening modes: Noise cancelling (the main measurement) and the others measured
# (headphones under sony-anc's control: all three, whether measured or not)
anc_modes() {
  if [[ -f $live/$(mac_of "$2") ]]; then printf '%s\n' "Noise cancelling" Transparency Passive
  elif [[ -n $1 ]]; then echo "Noise cancelling"; presets | grep -F "$1 · " | awk -F ' · ' 'NF == 3 { print $3 }' | sort -u; fi
}
# Style -> the preset's full name for these headphones (and their listening mode)
full_name() {
  local s=$1 key=$2 style=$3 mode
  [[ $style == Off ]] && { echo Off; return; }
  if [[ -n $key && -f "$dir/output/$key · $style.json" ]]; then
    mode=$(anc_mode "$s")
    if [[ $mode != "Noise cancelling" && -f "$dir/output/$key · $style · $mode.json" ]]; then echo "$key · $style · $mode"; else echo "$key · $style"; fi
  else
    echo "$style"
  fi
}

case ${1:-current} in
  current)   # the style (Neutral, Bass, …) or off
    s=$(sink_name); [[ -n $s ]] || exit 1
    p=$(jq -r '."preset-name" // empty' "$(autoload_file "$s")" 2>/dev/null)
    [[ $p == *" · "*" · "* ]] && p=${p% · *}; p=${p##* · }
    [[ -z $p || $p == Off ]] && echo off || echo "$p" ;;
  list)      # the connected headphones' styles, or the generic ones; presets made in EasyEffects too
    s=$(sink_name); key=$([[ -n $s ]] && headphones_key "$s")
    { if [[ -n $key ]]; then presets | grep -F "$key · " | awk -F ' · ' 'NF == 2 { print $2 }'
        presets | grep -vF ' · ' | grep -vxF -e Off -e Bass -e Voice
      else presets | grep -vF ' · ' | grep -vx Off; fi; } | sort -u ;;
  info)
    s=$(sink_name); [[ -n $s ]] || { echo '{}'; exit; }
    key=$(headphones_key "$s")
    mac=$(mac_of "$s")
    bat=$(bluetoothctl info "$mac" 2>/dev/null | grep -oP 'Battery Percentage:.*\(\K[0-9]+')
    modes=$(anc_modes "$key" "$s")
    [[ -f $live/$mac ]] && controlled=true || controlled=false
    pactl -f json list sinks | jq -c --arg s "$s" --arg def "$(pactl get-default-sink)" --arg bat "$bat" \
      --arg cur "$("$0" current)" --arg presets "$("$0" list)" --arg key "$key" --arg modes "$modes" --arg anc "$(anc_mode "$s")" --argjson controlled $controlled \
      '.[] | select(.name == $s) | {sink: $s, name: .description, default: ($s == $def), battery: $bat,
        codec: (.properties["api.bluez5.codec"] // "" | ascii_upcase), preset: $cur, presets: ($presets | split("\n") | map(select(. != ""))),
        tuned: ($key != ""), ancModes: ($modes | split("\n") | map(select(. != ""))), anc: $anc, ancControlled: $controlled}' ;;
  set)
    style=${2:?style}; s=$(sink_name); [[ -n $s ]] || exit 1
    p=$(full_name "$s" "$(headphones_key "$s")" "$style")
    f=$(autoload_file "$s"); mkdir -p "$(dirname "$f")"
    jq -n --arg d "$s" --arg desc "$(description "$s")" --arg r "$(basename "$f" .json | cut -d: -f2-)" --arg p "$p" \
      '{device:$d, "device-description":$desc, "device-profile":$r, "preset-name":$p}' > "$f"
    [[ $style != Off ]] && { mkdir -p "$(dirname "$last")"; echo "$style" > "$last"; }
    pgrep -x easyeffects >/dev/null || { easyeffects --service-mode -w >/dev/null 2>&1 & sleep 1; }
    easyeffects -b 2 >/dev/null 2>&1   # just in case: turn global bypass off
    # Load immediately only if the headphones are the default device now; otherwise autoload handles it on switching to them
    [[ $(pactl get-default-sink) == "$s" ]] && easyeffects -l "$p" >/dev/null 2>&1
    true ;;
  toggle)
    if [[ $("$0" current) == off ]]; then
      p=$(cat "$last" 2>/dev/null); "$0" list | grep -qxF "$p" || p=$("$0" list | grep -x Neutral || "$0" list | head -1)
      "$0" set "${p:-Off}"
    else "$0" set Off; fi ;;
  anc)       # the headphones' listening mode (Noise cancelling, Transparency, Passive …): the EQ switches to that measurement
    mode=${2:?mode}; s=$(sink_name); [[ -n $s ]] || exit 1
    if [[ -f $live/$(mac_of "$s") ]]; then   # switch the headphones themselves; sony-anc then updates the EQ
      python3 -c 'import socket, sys; c = socket.socket(socket.AF_UNIX); c.connect(sys.argv[1]); c.send(sys.argv[2].encode()); c.recv(16)' \
        "$livesock" "$(mac_of "$s") $mode"
      exit
    fi
    if [[ $mode == "Noise cancelling" ]]; then rm -f "$ancdir/$s"; else mkdir -p "$ancdir"; echo "$mode" > "$ancdir/$s"; fi
    cur=$("$0" current); [[ $cur != off ]] && "$0" set "$cur"
    true ;;
  disconnect)   # the headphones' Bluetooth connection off (right click on the bar icon)
    s=$(sink_name); [[ -n $s ]] || exit 1
    bluetoothctl disconnect "$(sed -E 's/^bluez_output\.([0-9A-F_]+).*/\1/; s/_/:/g' <<<"$s")" >/dev/null ;;
esac
