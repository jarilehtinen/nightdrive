{
  // Personal additions from a private overlay: local.jsonc defines "group/local" (the left end of the icons) and its
  // modules; without it the group is simply hidden. local.css styles them, status.local adds cases to scripts/status.
  "include": ["~/.config/waybar/local.jsonc"],
  "layer": "top",
  "position": "top",
  "height": 37,
  "spacing": 3,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  // Icon order: keep in the same order as orderStart/orderEnd in quickshell/shell.qml (keyboard navigation, icon positions)
  "modules-right": ["group/local", "custom/deck", "custom/claude", "custom/system", "image#tailscale", "custom/bluetooth", "custom/wifi", "custom/volume", "custom/headphones", "custom/battery", "custom/clock", "custom/notifications"],

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": { "*": 5 }
  },
  "custom/clock": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status calendar",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu calendar"
  },
  "custom/wifi": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status wifi",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu wifi",
    "on-click-right": "kitty --class floating-tui -e nmtui"
  },
  "custom/volume": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status volume",
    "return-type": "json",
    "interval": 2,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu volume",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+8 waybar",
    "on-click-middle": "pavucontrol"
  },
  "custom/headphones": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status headphones",
    "return-type": "json",
    "interval": 3,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu headphones",
    "on-click-right": "~/.config/waybar/scripts/eq toggle && pkill -RTMIN+8 waybar",
    "on-click-middle": "easyeffects"
  },
  "custom/battery": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status battery",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu battery"
  },
  "custom/bluetooth": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status bluetooth",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu bluetooth",
    "on-click-right": "blueman-manager"
  },
  "custom/claude": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status claude",
    "return-type": "json",
    "interval": 60,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu claude",
    "on-click-middle": "xdg-open https://claude.ai/settings/usage"
  },
  "custom/system": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status system",
    "return-type": "json",
    "interval": 3,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu system"
  },
  "custom/deck": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status deck",
    "return-type": "json",
    "interval": 2,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu deck",
    "on-click-right": "~/.config/hypr/scripts/deck-open"
  },
  "image#tailscale": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/tailscale image",
    "interval": 5,
    "signal": 8,
    "size": 31,
    "on-click": "~/.config/waybar/scripts/menu tailscale",
    "on-click-right": "~/.config/waybar/scripts/tailscale toggle"
  },
  "custom/notifications": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/status notifications",
    "return-type": "json",
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/menu notifications"
  }
}
