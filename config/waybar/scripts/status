#!/bin/bash
# Waybar icons as separate modules. Prints JSON {text, tooltip, class}.
# Class "open" is added while the matching Quickshell menu is open (Quickshell writes the state to
# $XDG_RUNTIME_DIR/qs-menu and sends waybar signal RTMIN+8, so the icon updates immediately).
# Usage: status <wifi|bluetooth|volume|headphones|battery|deck|claude|system|calendar|notifications>
kind=${1:?usage: status <wifi|bluetooth|volume|headphones|battery|deck|claude|system|calendar|notifications>}
open=$(cat "${XDG_RUNTIME_DIR:-/tmp}/qs-menu" 2>/dev/null)

# The machine's own battery as UPower names it (MacBook: battery_macsmc_battery). Found in /sys/class/power_supply,
# skipping Bluetooth mice and keyboards (scope Device). Empty on a desktop: the module stays hidden.
battery() {
  local d
  for d in /sys/class/power_supply/*; do
    [[ $(cat "$d/type" 2>/dev/null) == Battery && $(cat "$d/scope" 2>/dev/null) != Device ]] || continue
    local n=${d##*/}; echo "/org/freedesktop/UPower/devices/battery_${n//-/_}"; return
  done
}

emit() {  # emit TEXT TOOLTIP [CLASS...]
  local text=$1 tip=$2; shift 2
  local cls=("$@")
  [[ $open == "$kind" ]] && cls+=(open)
  jq -nc --arg t "$text" --arg tip "$tip" --args '{text:$t, tooltip:$tip, class:$ARGS.positional}' "${cls[@]}"
}

case $kind in
  wifi)
    if [[ $(nmcli radio wifi 2>/dev/null) != enabled ]]; then emit "" "Wifi is off" off; exit; fi
    line=$(nmcli -t -f ACTIVE,SSID,SIGNAL device wifi list --rescan no 2>/dev/null | grep '^yes:' | head -1)
    if [[ -n $line ]]; then
      IFS=: read -r _ ssid sig <<<"$line"
      emit "" "$ssid ($sig%)"
    elif nmcli -t -f TYPE,STATE device 2>/dev/null | grep -q '^ethernet:connected'; then
      emit "" "Wired connection"
    else
      emit "" "Not connected" disconnected
    fi ;;
  bluetooth)
    # Without an adapter (a VM) bluetooth.service is stopped and bluetoothctl would wait forever
    if ! systemctl is-active -q bluetooth || ! timeout 2 bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then emit "" "Bluetooth is off" off; exit; fi
    conn=$(bluetoothctl devices Connected 2>/dev/null | cut -d' ' -f3-)
    if [[ -n $conn ]]; then emit "" "$conn" connected; else emit "" "Bluetooth on"; fi ;;
  volume)
    v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    pct=$(awk '{printf "%d", $2*100+0.5}' <<<"$v")
    if grep -q MUTED <<<"$v"; then emit "" "Muted" muted
    elif (( pct < 50 )); then emit "" "$pct%"
    else emit "" "$pct%"; fi ;;
  headphones)
    # Shown only while Bluetooth headphones are connected. Dimmed when the EasyEffects EQ is off.
    sink=$(pactl list short sinks 2>/dev/null | awk '$2 ~ /^bluez_output/ {print $2; exit}')
    [[ -z $sink ]] && { emit "" ""; exit; }
    preset=$(~/.config/waybar/scripts/eq current 2>/dev/null)
    if [[ -z $preset || $preset == off ]]; then emit $'\ue0f4' "Headphones · EQ off" off
    else emit $'\ue0f4' "Headphones · EQ: $preset"; fi ;;
  battery)
    dev=$(battery); [[ -z $dev ]] && { emit "" ""; exit; }
    info=$(upower -i "$dev" 2>/dev/null)
    pct=$(grep -oP 'percentage:\s*\K[0-9]+' <<<"$info"); st=$(grep -oP 'state:\s*\K\S+' <<<"$info")
    cls=()
    if [[ $st == charging ]]; then icon=""; cls+=(charging)
    else
      (( pct <= 10 )) && cls+=(critical) || { (( pct <= 20 )) && cls+=(warning); }
      if (( pct < 40 )); then icon=""; elif (( pct < 60 )); then icon=""; else icon=""; fi
    fi
    emit "<span size=\"12288\" rise=\"256\">$icon</span><span rise=\"4096\"><span letter_spacing=\"-3456\"> </span>${pct}%</span>" "${pct}% · ${st}" "${cls[@]}" ;;
  deck)
    f="${XDG_RUNTIME_DIR:-/tmp}/deck/state.json"
    pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)
    if [[ -z $pid || ! -d /proc/$pid ]]; then emit "" "Deck is not running" off; exit; fi
    info=$(jq -c '.info' "$f")
    if [[ $info == null ]]; then emit "" "Deck: nothing playing" idle; exit; fi
    tip=$(jq -r '"\(.artist) – \(.title)"' <<<"$info")
    if [[ $(jq -r .playing <<<"$info") == true ]]; then emit "" "$tip" playing; else emit "" "$tip (paused)" paused; fi ;;
  claude)
    ic='<span size="13056" rise="-3584"></span>'
    u=$(~/.config/waybar/scripts/claude-usage)
    read -r sess weekly < <(jq -r '[(.windows // [] | map(select(.key == "session")) | first // {}).percent // -1,
      (.windows // [] | map(select(.key == "weekly")) | first // {}).percent // -1] | @tsv' <<<"$u")
    if (( sess < 0 )); then emit "$ic" "Claude usage: $(jq -r '.error // "no data"' <<<"$u")" off; exit; fi
    cls=()
    (( sess > 95 )) && cls+=(high)          # colour follows the 5 h window only, not the week
    (( sess > 90 && sess <= 95 )) && cls+=(mid)
    emit "$ic<span letter_spacing=\"-1152\"> </span>$sess%" "Claude: 5 h $sess% · week $weekly%" "${cls[@]}" ;;
  system)
    IFS=$'\t' read -r pct tip cls < <(~/.config/waybar/scripts/sysinfo bar)
    emit "<span size=\"11520\" rise=\"-2816\"></span>" "${tip//\\n/$'\n'}" $cls ;;
  calendar)
    emit "$(LC_TIME=en_GB.UTF-8 date '+%a %d.%m. %H:%M')" "" ;;
  notifications)
    emit "" "Notifications" ;;
  *)  # modules of a private overlay: status.local has its own case for them and can use emit
    [[ -f ~/.config/waybar/status.local ]] && source ~/.config/waybar/status.local ;;
esac
