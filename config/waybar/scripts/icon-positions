#!/usr/bin/env python3
"""Prints the centre points of the top bar's right-hand icons as JSON {name: x} (logical px).
Usage: icon-positions name1 name2 ...   (names in bar order from left to right, right-hand modules only)
Waybar doesn't expose icon positions, so the bar is screenshotted (grim) and icons are detected column by column:
a column is "content" if its middle band has a pixel that matches none of the bar's background colours. Nearby
columns (icon + text, highlighted background) belong to the same group. If there aren't exactly as many groups as names, prints {}."""
import json, subprocess, sys

names = sys.argv[1:]
mon = json.loads(subprocess.check_output(["hyprctl", "-j", "monitors"]))[0]
scale = mon["scale"]; lw = int(mon["width"] / scale); bar_h = 37
data = subprocess.check_output(["grim", "-g", f"0,0 {lw}x{bar_h}", "-t", "ppm", "-"])

# PPM (P6) -> width, height, pixels
parts = data.split(b"\n", 3)
w, h = map(int, parts[1].split())
pix = parts[3]
row = w * 3
def px(x, y): o = y * row + x * 3; return pix[o], pix[o + 1], pix[o + 2]

y0, y1 = int(h * 0.25), int(h * 0.75)
def near(a, b): return abs(a[0] - b[0]) + abs(a[1] - b[1]) + abs(a[2] - b[2]) <= 48
# Background colours: the bar itself plus the boxes behind highlighted modules (open menu, playing, theme colour...).
# Sampled on a row inside the boxes but above the icons; a colour counts if it covers at least 4 logical px of that row.
ybox = int(8 * h / bar_h)
counts = []
for x in range(w):
    c = px(x, ybox)
    for e in counts:
        if near(c, e[0]): e[1] += 1; break
    else: counts.append([c, 1])
bgs = [px(0, 1)] + [c for c, n in counts if n >= 4 * w / lw]
content = [any(not any(near(px(x, y), b) for b in bgs) for y in range(y0, y1)) for x in range(w)]
# A single-pixel run is the antialiased edge of a highlight box, not an icon
content = [c and (x > 0 and content[x - 1] or x + 1 < w and content[x + 1]) for x, c in enumerate(content)]

gap = int(14 * w / lw)       # 14 logical px: group boundary (the gap between clock words is ~9, between modules over 20)
groups, start, last = [], None, None
for x, c in enumerate(content):
    if not c: continue
    if start is None: start = last = x
    elif x - last > gap: groups.append((start, last)); start = last = x
    else: last = x
if start is not None: groups.append((start, last))

right = [g for g in groups if (g[0] + g[1]) / 2 / w * lw > 400]   # workspaces are on the left
if len(right) != len(names): print("{}"); sys.exit(0)
print(json.dumps({n: round((g[0] + g[1]) / 2 * lw / w) for n, g in zip(names, right)}))
