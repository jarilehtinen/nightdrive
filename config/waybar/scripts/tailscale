#!/bin/bash
# Waybar image module: Tailscale status. "image" prints the icon and tooltip, "toggle" switches it on/off.
if [[ ${1:-} == toggle ]]; then
  state=$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "Stopped"')
  if [[ $state == Running ]]; then cmd=down; else cmd=up; fi
  tailscale $cmd 2>&1 | grep -qiE 'access denied|operator' \
    && notify-send "Tailscale" "Permission denied. Run once: sudo tailscale set --operator=\$USER"
  exit 0
fi

# Image module: first line = image path, the rest = tooltip
if [[ ${1:-} == image ]]; then
  icons=~/.cache/waybar/icons   # written by bar-style (colours per setting; templates in ~/.config/waybar/icons)
  [[ $(cat "${XDG_RUNTIME_DIR:-/tmp}/qs-menu" 2>/dev/null) == tailscale ]] && sfx=-open || sfx=
  json=$(tailscale status --json 2>/dev/null) || { printf '%s\nTailscale is not running\n' "$icons/tailscale-off$sfx.svg"; exit 0; }
  if [[ $(jq -r '.BackendState' <<<"$json") == Running ]]; then
    printf '%s\nTailscale: connected\n%s · %s\n' "$icons/tailscale-on$sfx.svg" "$(jq -r '.CurrentTailnet.Name' <<<"$json")" "$(jq -r '.Self.TailscaleIPs[0]' <<<"$json")"
  else
    printf '%s\nTailscale: disconnected\n' "$icons/tailscale-off$sfx.svg"
  fi
  exit 0
fi

