#!/bin/bash
# F8 / play: if some player (Deck, browser…) is on MPRIS -> play/pause; otherwise start Deck (or bring its window up),
# if it is installed (an optional part).
if playerctl -l 2>/dev/null | grep -q . || [[ ! -x $HOME/.local/bin/deck ]]; then
  exec playerctl play-pause
fi
exec "$(dirname "$(readlink -f "$0")")/deck-open"
