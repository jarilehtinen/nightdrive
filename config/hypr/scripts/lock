#!/bin/bash
# Locks the session with the login screen (greeter/lock.qml), the same lock as at boot: hypridle's lock_cmd (idle,
# before sleep, ⌃⌘L through loginctl lock-session). hyprlock, used before, didn't come back from sleep on a PC: the
# password field showed but took no keys, and Hyprland's "lock died" screen flashed around it.
# A lock already up stays (idle and sleep both ask for one).
pgrep -u "$USER" -f '[q]s -p .*/greeter/lock\.qml' >/dev/null && exit 0
pam=login; [[ -e /etc/pam.d/nightdrive-lock ]] && pam=nightdrive-lock   # as hyprland.lua: it also opens the keyring
NIGHTDRIVE_LOCK_PAM=$pam exec qs -p "$HOME/.config/greeter/lock.qml"
