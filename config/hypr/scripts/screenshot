#!/bin/bash
# screenshot region   → region: saved to ~/Pictures/Screenshots (the localised Pictures folder) and the clipboard (launcher → Screenshot)
# screenshot window   → click a window on the current workspace: saved and to the clipboard (launcher)
# screenshot full     → whole screen: saved and to the clipboard (launcher)
# screenshot clip     → region to the clipboard only, no file (⌘R)
# screenshot winclip  → window to the clipboard only, no file (⌘⇧R)
mode=${1:-full}

# A selection is already running (slurp open): a second press cancels it instead of starting a new capture
if [[ $mode != full ]] && pgrep -x slurp >/dev/null; then pkill -x slurp; exit 0; fi

# Pick a window by clicking: the current workspace's window bounds go to slurp (-r: only these boxes are selectable)
pick_window() {
  local ws
  ws=$(hyprctl -j activeworkspace | jq .id)
  hyprctl -j clients | jq -r --argjson ws "$ws" \
    '.[] | select(.workspace.id == $ws and .mapped and (.hidden | not)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' \
    | slurp -r
}

# The notification shows the picture small under its text (category x-nightdrive.preview: quickshell/NotificationCard.qml)
notify() { notify-send -c x-nightdrive.preview -h "string:image-path:file://$1" "Screenshot" "$2"; }   # file://: a bare path would be taken as an icon name

# Clipboard only: the picture for the notification's preview in the runtime dir (gone at logout)
clip=${XDG_RUNTIME_DIR:-/tmp}/screenshots
case "$mode" in
  clip|winclip)
    if [[ $mode == clip ]]; then geom=$(slurp) || exit 0; what=Region; else geom=$(pick_window) || exit 0; what=Window; fi
    mkdir -p "$clip"; find "$clip" -name '*.png' -mmin +60 -delete 2>/dev/null
    f=$clip/$(date +%H-%M-%S-%N).png
    grim -g "$geom" "$f" && wl-copy --type image/png < "$f"
    notify "$f" "$what copied to clipboard"; exit 0 ;;
esac

dir="$(xdg-user-dir PICTURES)/Screenshots"   # e.g. ~/Kuvat on a Finnish system
mkdir -p "$dir"
file=$dir/$(date +%Y-%m-%d_%H-%M-%S).png
case "$mode" in
  region) geom=$(slurp) || exit 0;        grim -g "$geom" "$file" ;;
  window) geom=$(pick_window) || exit 0;  grim -g "$geom" "$file" ;;
  *)      grim "$file" ;;
esac
wl-copy < "$file"
notify "$file" "Saved and copied to clipboard"
