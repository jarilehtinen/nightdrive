#!/usr/bin/python3 -I
"""Colour theme (launcher Settings › Theme › Color). Choice: ~/.local/state/theme-color.

  theme color [name]   prints / sets the theme and applies it
  theme list           "key<TAB>name<TAB>main colour hex<TAB>current?" for the launcher
  theme apply          writes ~/.cache/nightdrive/: theme.json (Quickshell), mako.conf, fuzzel.ini, hyprlock.conf
                       (Hyprland autostart runs it before mako and Quickshell)

Shades are derived from the original violet: each role keeps its lightness and saturation, only the hue changes.
So Violet produces exactly the original colours. The login screen (/etc/greetd) stays violet.
"""
import colorsys, json, os, subprocess, sys

HOME = os.environ["HOME"]
STATE = f"{HOME}/.local/state/theme-color"
OUT = f"{HOME}/.cache/nightdrive"

# Roles as the original violets (Theme.qml, mako, fuzzel, hyprlock, voxtype, top bar)
BASE = {
    "primary": "#c071eb",   # borders, highlights
    "accent":  "#e0bff2",   # selected text and icons
    "sel":     "#35253d",   # selected row
    "hover":   "#1f1528",   # row under the mouse
    "border":  "#3a2f45",
    "text":    "#c9bdd3",
    "muted":   "#aea3b5",   # notification and fuzzel text
    "dim":     "#9486a3",
    "soft":    "#b17bcb",   # top bar active workspace (white icons)
    "deep":    "#5c247b",   # top bar highlights (black icons)
}
BASE_HUE = 279

# name → (display name, hue in degrees, saturation multiplier)
THEMES = {
    "violet":   ("Violet", 279, 1.0),
    "blue":     ("Blue", 221, 1.0),
    "teal":     ("Teal", 178, 0.85),
    "green":    ("Green", 135, 0.7),
    "amber":    ("Amber", 36, 0.95),
    "rose":     ("Rose", 340, 0.9),
    "graphite": ("Graphite", 279, 0.0),
}


def hex2rgb(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))


def rgb2hex(r, g, b):
    return "#" + "".join(f"{round(max(0, min(1, x)) * 255):02x}" for x in (r, g, b))


def palette(name):
    _, hue, sat = THEMES[name]
    out = {}
    for role, h in BASE.items():
        hh, ll, ss = colorsys.rgb_to_hls(*hex2rgb(h))
        if name == "violet":
            out[role] = h
            continue
        # hue differences within the violet palette are kept (hue shift), saturation is multiplied
        nh = (hh * 360 - BASE_HUE + hue) % 360 / 360
        out[role] = rgb2hex(*colorsys.hls_to_rgb(nh, ll, min(1, ss * sat)))
    return out


def current():
    try:
        v = open(STATE).read().strip()
    except OSError:
        v = ""
    return v if v in THEMES else "violet"


def write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)        # atomic: Quickshell's FileView never sees a half-written file


def apply():
    p = palette(current())
    os.makedirs(OUT, exist_ok=True)
    write(f"{OUT}/theme.json", json.dumps(dict(p, name=current()), indent=1) + "\n")
    hx = {k: v[1:] for k, v in p.items()}
    # Notification icons (mako/icons, drawn in the original muted colour) in the theme's text colour
    src, icons = f"{HOME}/.config/mako/icons", f"{OUT}/mako-icons"
    for d, _, files in os.walk(src):
        for name in files:
            os.makedirs(icons + d[len(src):], exist_ok=True)
            write(f"{icons}{d[len(src):]}/{name}", open(f"{d}/{name}").read().replace(BASE["muted"], p["muted"]))
    write(f"{OUT}/mako.conf", f"# written by theme\ntext-color={p['muted']}\nborder-color={p['primary']}\n"
          f"format=<b><span foreground=\"{p['primary']}\">%s</span></b>\\n<span size=\"9216\">%b</span>\n"   # title in the theme colour
          f"icon-path={icons}:/usr/share/icons/hicolor:/usr/share/pixmaps\n")
    write(f"{OUT}/fuzzel.ini", "# written by theme\n[colors]\n"
          f"text={hx['muted']}ff\ninput={hx['muted']}ff\nprompt={hx['primary']}ff\nmatch={hx['primary']}ff\nselection={hx['sel']}ff\n"
          f"selection-text={hx['accent']}ff\nselection-match={hx['primary']}ff\nborder={hx['primary']}ff\n")
    write(f"{OUT}/hyprlock.conf", f"# written by theme\n$primary = rgb({hx['primary']})\n$accent = rgb({hx['accent']})\n")


def reload():
    run = lambda *c: subprocess.run(c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    run("makoctl", "reload")
    run(f"{HOME}/.config/hypr/scripts/bar-style", "apply")       # top bar colours (the bar watches the file)


args = sys.argv[1:]
if args[:1] == ["apply"]:
    apply()
elif args[:1] == ["list"]:
    cur = current()
    for k, (label, _, _) in THEMES.items():
        print(f"{k}\t{label}\t{palette(k)['primary']}\t{'current' if k == cur else ''}")
elif args[:1] == ["color"]:
    if len(args) == 1:
        print(current())
    elif args[1] in THEMES:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        write(STATE, args[1] + "\n")
        apply()
        reload()
    else:
        sys.exit("unknown theme: " + args[1] + " (" + ", ".join(THEMES) + ")")
else:
    sys.exit(__doc__)
