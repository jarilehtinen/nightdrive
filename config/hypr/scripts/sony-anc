#!/usr/bin/env python3
"""Sony headphones' listening mode (noise cancelling / ambient sound / off) over Bluetooth, for the headphones menu.

Keeps Sony's control channel (the MDR protocol over RFCOMM, as Sony's own app uses it) open while Sony headphones are
connected: a press of the headphones' NC/AMBIENT button shows in the menu at once, and picking a mode in the menu
switches the headphones. Started by hyprland.lua.

  $XDG_RUNTIME_DIR/nightdrive/anc/<MAC>   the mode now, as the menu names it; exists while the channel is open
  $XDG_RUNTIME_DIR/nightdrive/sony-anc.sock   "<MAC> <mode>" switches the headphones (topbar/scripts/eq anc does this)

Protocol (reverse engineered by Gadgetbridge and mos9527/SonyHeadphonesClient): frames 3e <type> <seq> <len:4>
<payload> <checksum> 3c with 3c/3d/3e escaped as 3d <byte & ef>; type 0c = command, 01 = ack. Payload 66 <kind> asks
the noise cancelling / ambient state, 67 is the reply, 69 a notification (a button press), 68 sets it. <kind>:
  02  protocol v1 (WH-1000XM3, XM4)    17  v2 (XM5)    19  v2 with noise adaptation (XM6)
Tested on the WH-1000XM6; the others follow the same sources but are untested.
"""
import fcntl, os, socket, subprocess, sys
import dbus, dbus.service, dbus.mainloop.glib
from gi.repository import GLib

UUIDS = {"96cc203e-5068-46ad-b32d-e316f5e069ba": 1, "956c7b26-d49a-4ba8-b03f-b17d393cb6e2": 2}
MODES = {"nc": "Noise cancelling", "ambient": "Transparency", "off": "Passive"}
NAMES = {v: k for k, v in MODES.items()}
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "nightdrive")
STATE = os.path.join(RUN, "anc")
SOCK = os.path.join(RUN, "sony-anc.sock")
EQ = os.path.expanduser("~/.config/topbar/scripts/eq")
HDR, TRL, ESC = 0x3e, 0x3c, 0x3d


def frame(mtype, seq, payload):
    body = bytes([mtype, seq]) + len(payload).to_bytes(4, "big") + bytes(payload)
    body += bytes([sum(body) & 0xff])
    out = bytearray([HDR])
    for b in body:
        out += bytes([ESC, b & 0xef]) if b in (HDR, TRL, ESC) else bytes([b])
    return bytes(out + bytes([TRL]))


class Headphones:
    """One open control channel."""

    def __init__(self, mac, sock):
        self.mac, self.sock = mac, sock
        self.buf, self.seq, self.version, self.kind = b"", 0, None, None
        self.state = None   # the last reply / notification payload: its other values are kept when setting the mode
        self.queue = []     # commands waiting for the previous one's ack (the headphones take one at a time)
        self.waiting = False
        sock.setblocking(False)
        self.watch = GLib.io_add_watch(sock.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.readable)
        self.send([0x00, 0x00])   # init: the reply tells the protocol version

    def send(self, payload):
        self.queue.append(payload)
        self.flush()

    def flush(self):
        if not self.waiting and self.queue:
            self.sock.send(frame(0x0c, self.seq, self.queue.pop(0)))
            self.waiting = True

    def readable(self, fd, cond):
        try:
            chunk = self.sock.recv(4096)
        except BlockingIOError:
            return True
        except OSError:
            chunk = b""
        if not chunk or cond & (GLib.IO_HUP | GLib.IO_ERR):
            self.close()
            return False
        self.buf += chunk
        while HDR in self.buf and TRL in self.buf[self.buf.index(HDR):]:
            s = self.buf.index(HDR); e = self.buf.index(TRL, s)
            raw, self.buf = self.buf[s + 1:e], self.buf[e + 1:]
            data, i = bytearray(), 0
            while i < len(raw):
                if raw[i] == ESC and i + 1 < len(raw): data.append(raw[i + 1] | 0x10); i += 2
                else: data.append(raw[i]); i += 1
            if len(data) < 7:
                continue
            mtype, seq, payload = data[0], data[1], bytes(data[6:-1])
            if mtype == 0x01:   # ack: the next command may go
                self.seq, self.waiting = seq, False
                self.flush()
            else:
                self.sock.send(frame(0x01, 1 - seq, b""))
                self.message(payload)
        return True

    def message(self, p):
        if p[:1] == b"\x01" and self.version is None:   # init reply: 4 bytes = v1, 8 = v2
            self.version = 1 if len(p) == 4 else 2
            if self.version == 1:
                self.kind = 0x02; self.send([0x66, 0x02])
            else:   # XM6 answers 19, XM5 17: ask 19 first, 17 if that reply doesn't come
                self.send([0x66, 0x19])
                GLib.timeout_add(1500, self.fallback)
        elif p[:1] in (b"\x67", b"\x69") and len(p) > 2:
            if self.kind is None and p[1] in (0x17, 0x19) and not (p[1] == 0x17 and not any(p[2:])):
                self.kind = p[1]
            if p[1] == self.kind:
                self.state = p
                self.publish(self.mode())

    def fallback(self):
        if self.kind is None:
            self.send([0x66, 0x17])
        return False

    def mode(self):
        p = self.state
        if self.kind == 0x02:   # v1: [2] on, [3] 00 = nc/ambient, 02 = with wind reduction, [4] the choice
            if p[2] == 0: return "off"
            return "ambient" if p[4] == 0 else "nc"
        return "off" if p[3] == 0 else ("nc" if p[4] == 0 else "ambient")   # v2: [3] on, [4] 00 nc / 01 ambient

    def set_mode(self, mode):
        if self.state is None:
            return
        p = bytearray(self.state)
        if self.kind == 0x02:
            wind = p[3] == 0x02
            nc = (2 if wind else 1) if mode == "nc" else 0
            level = p[7] if len(p) > 7 else 0
            payload = [0x68, 0x02, 0x00 if mode == "off" else 0x11, p[3], nc, 0x01, p[6], 0 if mode == "nc" else level]
        else:
            p[0], p[2] = 0x68, 0x01   # set, value changed
            p[3] = 0 if mode == "off" else 1
            p[4] = 1 if mode == "ambient" else 0
            payload = list(p)
        self.send(payload)
        self.state = bytes(p) if self.kind != 0x02 else self.state
        self.publish(mode)

    def publish(self, mode):
        os.makedirs(STATE, exist_ok=True)
        path = os.path.join(STATE, self.mac)
        old = open(path).read() if os.path.exists(path) else ""
        if old != MODES[mode]:
            with open(path, "w") as f: f.write(MODES[mode])
            # the EQ follows the mode (headphones measured in several modes, see config/easyeffects/build-presets)
            subprocess.Popen(["bash", "-c", f'cur=$("{EQ}" current) && [[ $cur != off ]] && "{EQ}" set "$cur"'],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def close(self):
        try: self.sock.close()
        except OSError: pass
        try: os.remove(os.path.join(STATE, self.mac))
        except FileNotFoundError: pass
        connected.pop(self.mac, None)


connected = {}


class Profile(dbus.service.Object):
    @dbus.service.method("org.bluez.Profile1", in_signature="oha{sv}", out_signature="")
    def NewConnection(self, path, fd, props):
        mac = path.rsplit("dev_", 1)[1].replace("_", ":")
        if mac in connected:
            connected[mac].close()
        connected[mac] = Headphones(mac, socket.socket(fileno=fd.take()))

    @dbus.service.method("org.bluez.Profile1", in_signature="o", out_signature="")
    def RequestDisconnection(self, path):
        mac = path.rsplit("dev_", 1)[1].replace("_", ":")
        if mac in connected:
            connected[mac].close()

    @dbus.service.method("org.bluez.Profile1", in_signature="", out_signature="")
    def Release(self): pass


def try_connect(path):
    """Opens the control channel of a connected device that has Sony's service."""
    try:
        props = dbus.Interface(bus.get_object("org.bluez", path), "org.freedesktop.DBus.Properties").GetAll("org.bluez.Device1")
    except dbus.DBusException:
        return False
    mac = str(props.get("Address", ""))
    uuids = [str(u).lower() for u in props.get("UUIDs", [])]
    if not props.get("Connected") or mac in connected:
        return False
    for uuid in sorted(UUIDS, key=UUIDS.get, reverse=True):   # v2 first
        if uuid in uuids:
            dev = dbus.Interface(bus.get_object("org.bluez", path), "org.bluez.Device1")
            dev.ConnectProfile(uuid, reply_handler=lambda: None, error_handler=lambda e: None)
            break
    return False


def on_properties(iface, changed, invalidated, path=None):
    if iface == "org.bluez.Device1" and changed.get("Connected"):
        GLib.timeout_add_seconds(3, try_connect, path)   # after the audio profiles have settled


def on_command(src, cond):
    conn, _ = server.accept()
    try:
        mac, mode = conn.recv(256).decode().strip().split(" ", 1)
        if mac in connected and mode in NAMES:
            connected[mac].set_mode(NAMES[mode])
            conn.send(b"ok\n")
    except (ValueError, OSError):
        pass
    conn.close()
    return True


os.makedirs(RUN, exist_ok=True)
lock = open(os.path.join(RUN, "sony-anc.lock"), "w")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)   # one instance only
except BlockingIOError:
    sys.exit(0)
dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SystemBus()
if os.path.exists(STATE):
    for f in os.listdir(STATE): os.remove(os.path.join(STATE, f))   # left over from a previous run
try: os.remove(SOCK)
except FileNotFoundError: pass
server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
server.bind(SOCK); server.listen(4)
GLib.io_add_watch(server.fileno(), GLib.IO_IN, on_command)

mgr = dbus.Interface(bus.get_object("org.bluez", "/org/bluez"), "org.bluez.ProfileManager1")
for uuid, version in UUIDS.items():   # one object per profile: BlueZ takes a path once
    Profile(bus, f"/nightdrive/sony_anc_v{version}")
    mgr.RegisterProfile(f"/nightdrive/sony_anc_v{version}", uuid, {"Role": "client", "AutoConnect": False})
bus.add_signal_receiver(on_properties, "PropertiesChanged", "org.freedesktop.DBus.Properties", "org.bluez", path_keyword="path")
objects = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
for path, ifaces in objects.items():
    if "org.bluez.Device1" in ifaces:
        try_connect(path)
GLib.MainLoop().run()
