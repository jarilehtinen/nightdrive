#!/bin/bash
# After sleep (hypridle's after_sleep_cmd): a hyprlock started before it doesn't get the keyboard back. Hyprland adds
# the keyboards again on resume, and that hyprlock keeps the one it had, so the password field shows but typing does
# nothing (a PC with a USB keyboard). A new hyprlock takes the lock over (allow_session_lock_restore in hyprland.lua)
# within misc:lockdead_screen_delay there, so Hyprland's "lock died" screen doesn't show. Steps go to the journal
# (journalctl -t relock).
pidof hyprlock >/dev/null || exit 0
sleep 1   # the keyboards come back a moment after the resume
pidof hyprlock >/dev/null || { logger -t relock "unlocked meanwhile"; exit 0; }
logger -t relock "restarting hyprlock"
pkill -9 -x hyprlock
# The new one only gets the lock once the old one is gone
for _ in $(seq 50); do pidof hyprlock >/dev/null || break; sleep 0.05; done
logger -t relock "old hyprlock gone, starting a new one"
exec hyprlock
