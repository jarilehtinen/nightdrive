#!/bin/bash
# After sleep (hypridle's after_sleep_cmd): the lock that was up before it doesn't get the keyboard back. Hyprland adds
# the keyboards again on resume, and the lock's surface keeps none: the password field shows but takes no keys until
# it is clicked (and one started just before the sleep didn't draw at all). Seen on a PC with an NVIDIA card and a USB
# keyboard, with hyprlock and with the login screen alike. A new lock takes the lock over (allow_session_lock_restore
# in hyprland.lua) within misc:lockdead_screen_delay there, so Hyprland's "lock died" screen doesn't show. Steps go to
# the journal (journalctl -t relock).
lock='[q]s -p .*/greeter/lock\.qml'
pgrep -u "$USER" -f "$lock" >/dev/null || exit 0
sleep 1   # the keyboards come back a moment after the resume
pgrep -u "$USER" -f "$lock" >/dev/null || { logger -t relock "unlocked meanwhile"; exit 0; }
logger -t relock "restarting the lock"
pkill -9 -u "$USER" -f "$lock"
# The new one only gets the lock once the old one is gone
for _ in $(seq 50); do pgrep -u "$USER" -f "$lock" >/dev/null || break; sleep 0.05; done
logger -t relock "old lock gone, starting a new one"
exec "$HOME/.config/hypr/scripts/lock"
