#!/usr/bin/python3 -I
"""Gathers the parts of the plugin folders that are on (installed) where the desktop reads them. `nightdrive plugins
installed` runs this with one line per such folder on stdin: id<TAB>folder.
  plugin-parts
Writes, in ~/.cache/nightdrive/plugins.d (only when the content changes, so the file watches don't fire for nothing):
  active    the same id<TAB>folder lines: hypr/bindings.lua runs each folder's bindings.lua, hypr/scripts/shortcuts adds
            its SHORTCUTS.md
  bar.json  {modules, menus, sizes} for Quickshell (TopBar.qml, shell.qml): module.jsonc's modules, with their commands
            run in the plugin's folder; the folder's <Name>Menu.qml files by menu name; the modules' icon sizes
Outside the repo, so a read-only checkout (nightdrive sandbox) works too. Folders that aren't on aren't in either file,
so their module, menu, keys and shortcut lines don't show anywhere."""
import glob, json, os, shlex, sys

OUT = os.path.expanduser("~/.cache/nightdrive/plugins.d")
COMMANDS = ("status", "right", "middle", "drop")   # module.jsonc keys holding shell commands


def jsonc(path):
    """modules.jsonc's format: JSON with whole-line // comments."""
    with open(path) as f:
        return json.loads("\n".join(l for l in f.read().split("\n") if not l.lstrip().startswith("//")))


def write(name, text):
    path = os.path.join(OUT, name)
    try:
        if open(path).read() == text:
            return
    except OSError:
        pass
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def main():
    folders = [l.rstrip("\n").split("\t", 1) for l in sys.stdin if "\t" in l]
    modules, menus, sizes = [], {}, {}
    for pid, d in folders:
        here = "cd " + shlex.quote(d) + " && "
        path = os.path.join(d, "module.jsonc")
        if os.path.exists(path):
            try:
                defs = jsonc(path)
            except (OSError, ValueError) as e:
                print(f"plugin-parts: {path}: {e}", file=sys.stderr)
                defs = []
            for m in defs if isinstance(defs, list) else [defs]:
                if not isinstance(m, dict):
                    continue
                m = dict(m)
                m.setdefault("name", pid)
                m["needs"] = pid             # implied: Plugins.has(id) hides it like a core module's "needs"
                if "status" not in m and os.access(os.path.join(d, "status"), os.X_OK):
                    m["status"] = "./status"
                for k in COMMANDS:
                    if isinstance(m.get(k), str) and m[k]:
                        m[k] = here + m[k]
                if isinstance(m.get("size"), (int, float)):
                    sizes[m["name"]] = m["size"]
                modules.append(m)
        for f in sorted(glob.glob(os.path.join(d, "[A-Z]*Menu.qml"))):
            base = os.path.basename(f)[:-len("Menu.qml")]
            menus[base[0].lower() + base[1:]] = f
    os.makedirs(OUT, exist_ok=True)
    write("active", "".join(f"{pid}\t{d}\n" for pid, d in folders))
    write("bar.json", json.dumps({"modules": modules, "menus": menus, "sizes": sizes}, indent=1) + "\n")


if __name__ == "__main__":
    main()
