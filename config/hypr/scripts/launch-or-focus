#!/bin/bash
# launch-or-focus <class-regex> <command...>
# If a window (matching class) is already open, focus it (switching workspace if needed); otherwise launch the program.
# This way a second press of the shortcut doesn't open a duplicate.
# A window hidden in the background (special:bg: ⌘W on background apps, or a window rule that opens it straight in the background) is brought to the current workspace.
# With the drawer open that is the drawer, as for a new window: activeworkspace names the workspace under it.
# A window open on a workspace stays there: focusing it hides the drawer.
# With several windows (1Password's main window + Settings) the most recently focused one is picked, and if it is in the
# background, all of the app's hidden windows come along, so none is left stranded in special:bg.
# LAUNCH_HIDDEN=1 (autostart's background apps): only launch, leave the new window where it opens (special:bg).
pattern=$1; shift
hidden=$LAUNCH_HIDDEN; unset LAUNCH_HIDDEN   # not passed on to the app
REDRAW_WAIT=0.15   # seconds for an app to redraw at the new screen's scale (show)
find_win() { hyprctl -j clients | jq -r --arg re "$pattern" '[.[] | select(.class | test($re))] | sort_by(.focusHistoryID) | first | "\(.address // "") \(.workspace.name // "")"'; }
show() {  # $1 = address, $2 = workspace
  local cmds=() target mon bgmon a floating
  if [[ $2 == special:bg ]]; then
    read -r target mon < <(hyprctl -j monitors | jq -r '[.[] | select(.focused)] | first | "\(if .specialWorkspace.name == "special:drawer" then "\"special:drawer\"" else .activeWorkspace.id end) \(.name)"')
    # The screens have different scales (2 and 1.5): a window coming from the other screen is first shown as its old
    # frame stretched, until the app redraws. Moving special:bg (still hidden) to this screen first lets it redraw unseen.
    bgmon=$(hyprctl -j workspaces | jq -r '.[] | select(.name == "special:bg") | .monitor')
    if [[ -n $bgmon && $bgmon != "$mon" ]]; then
      hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"special:bg\", monitor = \"$mon\" })" >/dev/null
      sleep "$REDRAW_WAIT"
    fi
    while read -r a floating; do
      cmds+=("dispatch hl.dsp.window.move({ workspace = $target, window = \"address:$a\" })")
      # A floating window keeps its offset from the corner of the screen it was hidden on, so a window centred on the
      # laptop lands up and left on a bigger screen, and the other way round off to the bottom right. Its monitor in
      # special:bg is that workspace's, not the one it came from, so it can't tell: always centre it on the new screen.
      [[ $floating == true ]] && cmds+=("dispatch hl.dsp.window.center({ window = \"address:$a\" })")
    done < <(hyprctl -j clients | jq -r --arg re "$pattern" '.[] | select((.class | test($re)) and .workspace.name == "special:bg") | "\(.address) \(.floating)"')
  fi
  cmds+=("dispatch hl.dsp.focus({ window = \"address:$1\" })")
  # One batch, so the move and the centring land in the same frame: one by one, the window flashes at its old spot first
  local IFS=';'
  hyprctl --batch "${cmds[*]}" >/dev/null
}
read -r addr wsname < <(find_win)
if [[ -n $addr ]]; then
  show "$addr" "$wsname"
  exit 0
fi
# Not open: launch and wait for the window (it may open straight in the background), then bring it up
setsid "$@" >/dev/null 2>&1 &
[[ -n $hidden ]] && exit 0
for _ in $(seq 80); do
  sleep 0.25
  read -r addr wsname < <(find_win)
  if [[ -n $addr ]]; then show "$addr" "$wsname"; exit 0; fi
done
