#!/usr/bin/python3
"""LocalSend: receives files and text from phones and other computers running LocalSend (https://localsend.org).

    localsend status                   on | off
    localsend enable | disable         the receiver on/off (nightdrive-localsend.service, starts with the session)
    localsend run                      the receiver itself (the service)
    localsend devices                  the devices on the network (JSON), after asking them to answer
    localsend send FILE…               sends files or folders (Files › Send with LocalSend)
    localsend send-clipboard           sends the clipboard's text (launcher › Tools › LocalSend)
    localsend send-pick                picks files in a file chooser and sends them (launcher › Tools › LocalSend)

The LocalSend app's own window isn't needed: this speaks its protocol (github.com/localsend/protocol, v2). It answers
the multicast discovery on the local network, so the computer shows up in the phone's LocalSend under its host name.
A send asks first: a notification with Accept and Decline (nothing is saved without Accept, and no answer in a minute
is a Decline). Files go to the Downloads folder; a text (LocalSend's "Text" or a shared link) is shown in the notification
with a Copy button. The connection is HTTPS with a self-signed certificate made on the first run, as LocalSend does.

Sending goes the other way: the devices that announced themselves to the receiver are remembered (DEVICES), a send asks
them to answer again, one device is used as it is and several are picked from a list. The phone asks its user, so the
LocalSend app has to be open there (iOS doesn't let it listen in the background).
"""
import hashlib
import http.client
import json
import mimetypes
import os
import re
import secrets
import select
import shutil
import socket
import ssl
import struct
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 53317                 # LocalSend's port, for both the multicast discovery and HTTPS
GROUP = "224.0.0.167"        # LocalSend's multicast group
STATE = os.path.expanduser("~/.local/share/nightdrive/localsend")   # the certificate and its key
SERVICE = "nightdrive-localsend.service"
APP = "LocalSend"       # the notifications' app name
ICON = "smartphone"
ASK_TIMEOUT = 60             # seconds to answer Accept/Decline
SESSION_IDLE = 300           # seconds without an upload before a session is dropped (the sender went away)
REJOIN = 30                  # seconds between multicast re-joins: a Wi-Fi reconnect drops the membership
ANNOUNCE_EVERY = 600         # seconds between own announcements (also sent at start)
CHUNK = 1 << 20
DEVICES = os.path.expanduser("~/.cache/nightdrive/localsend-devices.json")   # the devices seen, for sending
FRESH = 900                  # seconds a device counts as present after it was last seen
DISCOVER_WAIT = 2.0          # seconds a send waits for the devices to answer its announcement
SEND_ASK_TIMEOUT = 120       # seconds the phone's user has to accept a send


def downloads():
    try:
        d = subprocess.run(["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True).stdout.strip()
    except OSError:
        d = ""
    return d if d and d != os.path.expanduser("~") else os.path.expanduser("~/Downloads")


def alias():
    try:
        pretty = subprocess.run(["hostnamectl", "--pretty"], capture_output=True, text=True).stdout.strip()
    except OSError:
        pretty = ""
    return pretty or socket.gethostname().split(".")[0].capitalize()


def certificate():
    """The self-signed certificate (made once) and its fingerprint: the SHA-256 of the DER certificate, as LocalSend."""
    cert, key = os.path.join(STATE, "cert.pem"), os.path.join(STATE, "key.pem")
    if not (os.path.exists(cert) and os.path.exists(key)):
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        subprocess.run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
                        "-days", "3650", "-subj", "/CN=LocalSend User", "-keyout", key, "-out", cert],
                       check=True, capture_output=True)
        os.chmod(key, 0o600)
    with open(cert) as f:
        der = ssl.PEM_cert_to_DER_cert(f.read())
    return cert, key, hashlib.sha256(der).hexdigest().upper()


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000


def notify(summary, body="", actions=(), wait=False, timeout=None, urgency=None, replace=""):
    """A notification (replacing the one with id replace). Returns (process, its id); with actions or wait the process
    waits for a button."""
    cmd = ["notify-send", "-a", APP, "-i", ICON, "-p"] + (["-r", replace] if replace.isdigit() else [])
    if urgency:
        cmd += ["-u", urgency]
    if timeout is not None:
        cmd += ["-t", str(timeout)]
    for key, label in actions:
        cmd += ["-A", f"{key}={label}"]
    if actions or wait:
        cmd.append("--wait")
    cmd += ["--", summary, body]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    nid = p.stdout.readline().strip()   # -p prints the id as soon as it's shown
    if not (actions or wait):
        p.wait()
    return p, nid


def close_notification(nid):
    if nid.isdigit():
        subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path",
                        "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.CloseNotification",
                        nid], capture_output=True)


def answer(p, nid, timeout):
    """The button pressed on a notification from notify(…, wait=True), or "" (closed, timed out)."""
    try:
        out, _ = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        p.kill()
        p.communicate()
        close_notification(nid)
        return ""
    return out.strip().splitlines()[-1] if out.strip() else ""


def follow(p, nid, actions):
    """Runs the button's command when one is pressed (a background thread, so the notification can wait)."""
    def wait():
        key = answer(p, nid, None)
        if key in actions:
            actions[key]()
    threading.Thread(target=wait, daemon=True).start()


def safe_path(root, name):
    """A file name from the sender inside root: a folder send has subfolders ("dir/file"), never "..", never absolute."""
    parts = [re.sub(r'[\x00-\x1f]', "", p).strip() for p in name.replace("\\", "/").split("/")]
    parts = [p for p in parts if p and p not in (".", "..")] or ["file"]
    return os.path.join(root, *parts)


def unique(path, taken):
    """path, or "name (2).ext" when it exists or another file of this send already has it."""
    base, ext = os.path.splitext(path)
    n = 1
    while os.path.exists(path) or path in taken:
        n += 1
        path = f"{base} ({n}){ext}"
    return path


_devices_lock = threading.Lock()


def load_devices():
    try:
        with open(DEVICES) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def remember(ip, info, own):
    """A device that announced or registered itself: kept by its fingerprint with the address it came from."""
    fp = str(info.get("fingerprint") or ip)
    if fp == own or not info.get("alias"):
        return
    with _devices_lock:
        devs = load_devices()
        old = devs.get(fp, {})
        devs[fp] = {"alias": str(info["alias"]), "deviceModel": info.get("deviceModel") or old.get("deviceModel"),
                    "deviceType": info.get("deviceType") or old.get("deviceType"), "ip": ip,
                    "port": int(info.get("port") or old.get("port") or PORT),
                    "protocol": info.get("protocol") or old.get("protocol") or "https", "seen": time.time()}
        devs = {k: v for k, v in devs.items() if time.time() - v.get("seen", 0) < 7 * 86400}
        os.makedirs(os.path.dirname(DEVICES), exist_ok=True)
        tmp = DEVICES + ".tmp"
        with open(tmp, "w") as f:
            json.dump(devs, f, ensure_ascii=False)
        os.replace(tmp, DEVICES)


class Session:
    def __init__(self, sender, ip, files):
        self.id = secrets.token_hex(8)
        self.sender, self.ip = sender, ip
        self.files = files          # id → {"token", "path", "size", "sha256", "done"}
        self.touched = time.monotonic()

    def finished(self):
        return all(f["done"] for f in self.files.values())


class Receiver:
    def __init__(self):
        self.cert, self.key, self.fingerprint = certificate()
        self.dest = downloads()
        self.lock = threading.Lock()
        self.session = None     # the one transfer at a time (LocalSend's 409 for another)
        self.asking = None      # (sender ip, notification process, id) while Accept/Decline is shown

    def info(self, full=True):
        d = {"alias": alias(), "version": "2.1", "deviceModel": "Nightdrive", "deviceType": "desktop",
             "fingerprint": self.fingerprint, "download": False}
        if full:
            d.update({"port": PORT, "protocol": "https"})
        return d

    # --- Discovery ---------------------------------------------------------------------------------------------
    def multicast(self):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)
        s.bind(("", PORT))
        mreq = struct.pack("4s4s", socket.inet_aton(GROUP), socket.inet_aton("0.0.0.0"))
        last = 0.0
        while True:
            # Re-join every round: after a Wi-Fi reconnect the old membership is gone (dropping a missing one fails)
            for opt in (socket.IP_DROP_MEMBERSHIP, socket.IP_ADD_MEMBERSHIP):
                try:
                    s.setsockopt(socket.IPPROTO_IP, opt, mreq)
                except OSError:
                    pass
            if time.monotonic() - last > ANNOUNCE_EVERY:
                last = time.monotonic()
                self.send_multicast(s, announce=True)
            if not select.select([s], [], [], REJOIN)[0]:
                continue
            data, (ip, _) = s.recvfrom(65535)
            try:
                msg = json.loads(data)
            except ValueError:
                continue
            if not isinstance(msg, dict) or msg.get("fingerprint") == self.fingerprint:
                continue
            remember(ip, msg, self.fingerprint)
            if msg.get("announce") or msg.get("announcement"):
                threading.Thread(target=self.reply, args=(s, ip, msg), daemon=True).start()

    def send_multicast(self, s, announce):
        d = self.info()
        d.update({"announce": announce, "announcement": announce})   # "announcement": LocalSend before 2.0
        try:
            s.sendto(json.dumps(d).encode(), (GROUP, PORT))
        except OSError:
            pass

    def reply(self, s, ip, msg):
        """An announcement from another device: introduce ourselves over HTTP(S), or by multicast when that fails."""
        proto = msg.get("protocol") if msg.get("protocol") in ("http", "https") else "https"
        url = f"{proto}://{ip}:{int(msg.get('port') or PORT)}/api/localsend/v2/register"
        req = urllib.request.Request(url, json.dumps(self.info()).encode(), {"Content-Type": "application/json"})
        try:
            answer = json.loads(urllib.request.urlopen(req, timeout=3, context=insecure()).read() or b"{}")
            if isinstance(answer, dict):
                remember(ip, dict(answer, port=msg.get("port"), protocol=proto), self.fingerprint)
        except Exception:
            self.send_multicast(s, announce=False)

    # --- Transfers ---------------------------------------------------------------------------------------------
    def current(self):
        """The session, or None once it has been idle too long (the sender went away mid-transfer)."""
        s = self.session
        if s and time.monotonic() - s.touched > SESSION_IDLE:
            self.end(s, interrupted=True)
            return None
        return s

    def prepare(self, ip, body):
        sender = body.get("info") or {}
        files = body.get("files") or {}
        if not isinstance(files, dict) or not files:
            return 400, None
        who = str(sender.get("alias") or ip)
        items = list(files.values())

        # A text (LocalSend's "Text" / a shared link): one text file whose content is in the preview, nothing to upload
        if len(items) == 1 and str(items[0].get("fileType", "")).startswith("text/") and items[0].get("preview"):
            text = str(items[0]["preview"])
            p, nid = notify(f"Text from {who}", text, actions=[("copy", "Copy")])
            follow(p, nid, {"copy": lambda: subprocess.run(["wl-copy", "--", text])})
            return 204, None

        with self.lock:
            s = self.current()
        if s and s.ip == ip:
            self.end(s, quiet=True)   # the same sender again: its last send failed on its side and was left open
        with self.lock:
            if self.asking or self.current():
                return 409, None
            self.asking = (ip, None, "")
        try:
            names = [os.path.basename(str(f.get("fileName", "file"))) for f in items]
            total = sum(int(f.get("size") or 0) for f in items)
            title = f"{who} wants to send {names[0]}" if len(items) == 1 else f"{who} wants to send {len(items)} files"
            shown = names[:4] + ([f"and {len(names) - 4} more"] if len(names) > 4 else [])
            body_text = (", ".join(shown) + " · " if len(items) > 1 else "") + human(total)
            p, nid = notify(title, body_text, actions=[("accept", "Accept"), ("decline", "Decline")],
                            timeout=ASK_TIMEOUT * 1000, urgency="critical")
            with self.lock:
                self.asking = (ip, p, nid)
            choice = answer(p, nid, ASK_TIMEOUT)
        finally:
            with self.lock:
                self.asking = None
        if choice != "accept":
            return 403, None

        taken, out = set(), {}
        for fid, f in files.items():
            path = unique(safe_path(self.dest, str(f.get("fileName") or fid)), taken)
            taken.add(path)
            out[str(fid)] = {"token": secrets.token_hex(16), "path": path, "size": int(f.get("size") or 0),
                             "sha256": (f.get("sha256") or "").lower(), "done": False}
        s = Session(who, ip, out)
        with self.lock:
            self.session = s
        return 200, {"sessionId": s.id, "files": {fid: f["token"] for fid, f in out.items()}}

    def upload(self, ip, q, chunks):
        with self.lock:
            s = self.current()
        if not s or s.id != q.get("sessionId"):
            return 409 if s else 403
        f = s.files.get(q.get("fileId", ""))
        if not f or f["token"] != q.get("token") or ip != s.ip:
            return 403
        os.makedirs(os.path.dirname(f["path"]), exist_ok=True)
        part = f["path"] + ".part"
        h = hashlib.sha256()
        try:
            with open(part, "wb") as out:
                for chunk in chunks:
                    out.write(chunk)
                    h.update(chunk)
                    s.touched = time.monotonic()
        except (OSError, ValueError) as e:
            print(f"upload of {f['path']} failed: {e}", flush=True)
            self.remove(part)
            return 500
        if f["sha256"] and h.hexdigest() != f["sha256"]:
            print(f"checksum mismatch: {f['path']}", flush=True)
            self.remove(part)
            return 422
        os.replace(part, f["path"])
        f["done"] = True
        if s.finished():
            self.end(s)
        return 200

    def cancel(self, ip, q):
        with self.lock:
            asking, s = self.asking, self.session
        if asking and asking[0] == ip and asking[1]:
            asking[1].kill()           # its answer() returns "": a Decline
            close_notification(asking[2])
        if s and s.id == q.get("sessionId"):
            self.end(s, interrupted=True)
        return 200

    def end(self, s, interrupted=False, quiet=False):
        with self.lock:
            if self.session is not s:
                return
            self.session = None
        done = [f["path"] for f in s.files.values() if f["done"]]
        for f in s.files.values():
            if not f["done"]:
                self.remove(f["path"] + ".part")
        if quiet:
            return
        if interrupted:
            notify(f"Transfer from {s.sender} stopped",
                   f"{len(done)} of {len(s.files)} files received" if done else "Nothing was saved", urgency="normal")
            return
        if len(done) == 1:
            title, target = f"Received {os.path.basename(done[0])}", done[0]
        else:
            title, target = f"Received {len(done)} files", None
        p, nid = notify(title, f"From {s.sender} · {os.path.basename(self.dest)}",
                        actions=[("default", "Open"), ("show", "Show in Files")])
        show = (lambda: subprocess.Popen(["nautilus", "--select", done[0]])) if target else \
            (lambda: subprocess.Popen(["xdg-open", self.dest]))
        opener = (lambda: subprocess.Popen(["xdg-open", target])) if target else show
        follow(p, nid, {"default": opener, "show": show})

    @staticmethod
    def remove(path):
        try:
            os.remove(path)
        except OSError:
            pass


def handler(r):
    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *a):
            print(f"{self.client_address[0]} {fmt % a}", flush=True)   # the journal: journalctl --user -u nightdrive-localsend

        def reply(self, code, data=None):
            body = json.dumps(data).encode() if data is not None else b""
            self.send_response(code)
            if data is not None:
                self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def read_json(self):
            n = int(self.headers.get("Content-Length") or 0)
            try:
                return json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                return None

        def body(self):
            """The request body in pieces: a Content-Length, or chunked (LocalSend on iOS sends files without a length)."""
            if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
                while True:
                    size = int(self.rfile.readline(1024).split(b";")[0].strip() or b"x", 16)   # ValueError: broken
                    if size == 0:
                        while self.rfile.readline(1024).strip():   # trailers up to the empty line
                            pass
                        return
                    while size > 0:
                        chunk = self.rfile.read(min(CHUNK, size))
                        if not chunk:
                            raise OSError("connection closed")
                        size -= len(chunk)
                        yield chunk
                    self.rfile.readline(1024)   # the CRLF after the chunk
            else:
                left = int(self.headers.get("Content-Length") or 0)
                while left > 0:
                    chunk = self.rfile.read(min(CHUNK, left))
                    if not chunk:
                        raise OSError("connection closed")
                    left -= len(chunk)
                    yield chunk

        def route(self):
            u = urllib.parse.urlsplit(self.path)
            return u.path.rstrip("/"), dict(urllib.parse.parse_qsl(u.query))

        def do_GET(self):
            path, _ = self.route()
            if path in ("/api/localsend/v2/info", "/api/localsend/v1/info"):
                self.reply(200, r.info(full=False))
            else:
                self.reply(404)

        def do_POST(self):
            path, q = self.route()
            ip = self.client_address[0]
            if path == "/api/localsend/v2/register":
                body = self.read_json()
                if isinstance(body, dict):
                    remember(ip, body, r.fingerprint)
                self.reply(200, r.info(full=False))
            elif path == "/api/localsend/v2/prepare-upload":
                body = self.read_json()
                code, data = r.prepare(ip, body) if isinstance(body, dict) else (400, None)
                self.reply(code, data)
            elif path == "/api/localsend/v2/upload":
                self.reply(r.upload(ip, q, self.body()))
            elif path == "/api/localsend/v2/cancel":
                self.reply(r.cancel(ip, q))
            else:
                self.reply(404)
    return Handler


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, receiver):
        super().__init__(("", PORT), handler(receiver))
        self.ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        self.ctx.load_cert_chain(receiver.cert, receiver.key)

    def handle_error(self, request, client_address):
        print(f"{client_address[0]} connection error: {sys.exc_info()[1]!r}", flush=True)   # a sender gone mid-request

    def finish_request(self, request, client_address):
        # TLS in the request's own thread: a slow or stuck handshake doesn't hold up the others
        try:
            request = self.ctx.wrap_socket(request, server_side=True)
        except (ssl.SSLError, OSError):
            return
        super().finish_request(request, client_address)


def run():
    r = Receiver()
    server = Server(r)
    threading.Thread(target=r.multicast, daemon=True).start()
    print(f"LocalSend: {r.info()['alias']} on port {PORT}, files to {r.dest}", flush=True)
    server.serve_forever()


# --- Sending ----------------------------------------------------------------------------------------------------
def insecure():
    ctx = ssl.create_default_context()
    ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE   # LocalSend's certificates are self-signed
    ctx.load_cert_chain(*certificate()[:2])   # the iPhone app wants ours too (TLS "certificate required")
    return ctx


def own_info():
    d = {"alias": alias(), "version": "2.1", "deviceModel": "Nightdrive", "deviceType": "desktop",
         "fingerprint": certificate()[2], "port": PORT, "protocol": "https", "download": False}
    return d


def discover():
    """The devices present: an announcement makes the open LocalSend apps register again with the receiver (the
    service), which keeps them in DEVICES."""
    d = dict(own_info(), announce=True, announcement=True)
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)
    try:
        s.sendto(json.dumps(d).encode(), (GROUP, PORT))
    except OSError:
        pass
    s.close()
    time.sleep(DISCOVER_WAIT)
    devs = load_devices()
    return sorted(({"id": k, **v} for k, v in devs.items() if time.time() - v.get("seen", 0) < FRESH),
                  key=lambda v: -v["seen"])


def pick_device():
    if status() != "on":
        notify("LocalSend is off", "Turn it on in the launcher: Install › Plugins › LocalSend", urgency="normal")
        return None
    devs = discover()
    if not devs:
        notify("No device found", "Open LocalSend on the phone, on the same network, and try again")
        return None
    if len(devs) == 1:
        return devs[0]
    rows = []
    for d in devs:
        rows += [d["id"], d["alias"], d.get("deviceModel") or ""]
    out = subprocess.run(["zenity", "--list", "--title=Send with LocalSend", "--text=Send to", "--column=id",
                          "--column=Device", "--column=Model", "--hide-column=1", "--print-column=1", *rows],
                         capture_output=True, text=True).stdout.strip()
    return next((d for d in devs if d["id"] == out), None)


def request(dev, path, body=b"", length=None, timeout=10):
    """A POST to the device: (status, the JSON answer or None). body is bytes or an open file (sent in pieces)."""
    cls = http.client.HTTPSConnection if dev.get("protocol", "https") == "https" else http.client.HTTPConnection
    kw = {"context": insecure()} if cls is http.client.HTTPSConnection else {}
    conn = cls(dev["ip"], dev.get("port") or PORT, timeout=timeout, **kw)
    try:
        kind = "application/octet-stream" if "/upload?" in path else "application/json"
        conn.request("POST", path, body=body,
                     headers={"Content-Type": kind, "Content-Length": str(len(body) if length is None else length)})
        res = conn.getresponse()
        data = res.read()
        try:
            return res.status, json.loads(data) if data else None
        except ValueError:
            return res.status, None
    finally:
        conn.close()


def send(items, dev):
    """Sends items ({"name", "size", "type", and "path" or "text"}) to dev, following it in one notification."""
    who = dev["alias"]
    files = {}
    for it in items:
        fid = secrets.token_hex(8)
        files[fid] = dict(it, id=fid)
    meta = {fid: {"id": fid, "fileName": f["name"], "size": f["size"], "fileType": f["type"], "sha256": None,
                  "preview": f.get("text")} for fid, f in files.items()}
    body = json.dumps({"info": own_info(), "files": meta}).encode()
    _, nid = notify(f"Waiting for {who}", "Accept on the phone (LocalSend has to be open there)", timeout=0)
    try:
        status, answer = request(dev, "/api/localsend/v2/prepare-upload", body, timeout=SEND_ASK_TIMEOUT)
    except (OSError, http.client.HTTPException):
        notify(f"{who} didn't answer", "Open LocalSend on the phone and try again", replace=nid)
        return 1
    if status == 204:
        notify(f"Sent to {who}", "", replace=nid)
        return 0
    if status != 200 or not isinstance(answer, dict):
        why = {403: "Declined", 409: "It's busy with another transfer", 401: "It asks for a PIN (not supported)"}
        notify(f"{who} didn't take it", why.get(status, f"Error {status}"), replace=nid)
        return 1
    sid, tokens = answer.get("sessionId", ""), answer.get("files") or {}
    todo = [f for fid, f in files.items() if fid in tokens]   # the receiver may take only some
    for i, f in enumerate(todo, 1):
        if len(todo) > 1:
            notify(f"Sending to {who}", f"{i} of {len(todo)}: {f['name']}", replace=nid, timeout=0)
        else:
            notify(f"Sending to {who}", f"{f['name']} · {human(f['size'])}", replace=nid, timeout=0)
        q = urllib.parse.urlencode({"sessionId": sid, "fileId": f["id"], "token": tokens[f["id"]]})
        try:
            if "text" in f:   # a text the receiver wants uploaded after all (most show the preview and answer 204)
                status, _ = request(dev, "/api/localsend/v2/upload?" + q, f["text"].encode(), timeout=60)
            else:
                with open(f["path"], "rb") as fh:
                    status, _ = request(dev, "/api/localsend/v2/upload?" + q, fh, f["size"], timeout=60)
        except (OSError, http.client.HTTPException) as e:
            status = str(e)
        if status != 200:
            try:
                request(dev, "/api/localsend/v2/cancel?" + urllib.parse.urlencode({"sessionId": sid}))
            except (OSError, http.client.HTTPException):
                pass
            notify(f"Sending to {who} stopped", f"{f['name']}: {status}", replace=nid)
            return 1
    what = todo[0]["name"] if len(todo) == 1 else f"{len(todo)} files"
    notify(f"Sent {what} to {who}", "", replace=nid)
    return 0


def file_items(paths):
    """Files to send; a folder becomes its files, named with the folder's relative path ("Trip/IMG_1.HEIC")."""
    out = []
    for p in paths:
        p = os.path.abspath(p)
        if os.path.isdir(p):
            base = os.path.dirname(p.rstrip("/"))
            for root, _, names in os.walk(p):
                for n in sorted(names):
                    full = os.path.join(root, n)
                    out.append(file_item(full, os.path.relpath(full, base)))
        elif os.path.isfile(p):
            out.append(file_item(p, os.path.basename(p)))
    return out


def file_item(path, name):
    return {"name": name, "path": path, "size": os.path.getsize(path),
            "type": mimetypes.guess_type(path)[0] or "application/octet-stream"}


def send_files(paths):
    items = file_items(paths)
    if not items:
        notify("Nothing to send", "Pick files or folders")
        return 1
    dev = pick_device()
    return send(items, dev) if dev else 1


def send_clipboard():
    text = subprocess.run(["wl-paste", "--no-newline", "--type", "text"], capture_output=True, text=True).stdout
    if not text.strip():
        notify("The clipboard has no text", "Copy a text or a link first")
        return 1
    dev = pick_device()
    if not dev:
        return 1
    fid = secrets.token_hex(8)
    return send([{"name": fid + ".txt", "size": len(text.encode()), "type": "text/plain", "text": text}], dev)


def send_pick():
    out = subprocess.run(["zenity", "--file-selection", "--multiple", "--separator=\n", "--title=Send with LocalSend"],
                         capture_output=True, text=True).stdout
    paths = [p for p in out.splitlines() if p]
    return send_files(paths) if paths else 0


def systemctl(*a):
    return subprocess.run(["systemctl", "--user", *a], capture_output=True, text=True)


def status():
    return "on" if systemctl("is-enabled", "-q", SERVICE).returncode == 0 else "off"


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "status"
    if cmd == "status":
        print(status())
    elif cmd == "enable":
        if not shutil.which("openssl"):
            print("openssl is needed for the certificate", file=sys.stderr)
            return 1
        certificate()
        systemctl("daemon-reload")
        res = systemctl("enable", "--now", SERVICE)
        if res.returncode:
            print(res.stderr.strip(), file=sys.stderr)
            return 1
    elif cmd == "disable":
        systemctl("disable", "--now", SERVICE)
    elif cmd == "run":
        run()
    elif cmd == "devices":
        print(json.dumps(discover(), ensure_ascii=False))
    elif cmd == "send" and len(a) > 1:
        return send_files(a[1:])
    elif cmd == "send-clipboard":
        return send_clipboard()
    elif cmd == "send-pick":
        return send_pick()
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
