#!/usr/bin/env python3
"""Nightdrive screensaver 2: falling glyphs + glitch in violet/synthwave colours. Exits on any key."""
import os, random, select, signal, sys, termios, time, tty

FPS = 24
GLYPHS = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789:=*+<>|"
BG = (9, 2, 20)
HEAD = (255, 215, 255)
TRAIL_TOP, TRAIL_BOT = (220, 70, 255), (45, 8, 95)
GLITCH_COLS = ((255, 60, 200), (80, 230, 255))

def lerp(a, b, t): return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))

class Rain:
    def __init__(s, W, H):
        s.W, s.H = W, H
        s.grid = [[random.choice(GLYPHS) for _ in range(W)] for _ in range(H)]
        s.head = [random.uniform(-H * 2, H) for _ in range(W)]
        s.speed = [random.uniform(8, 26) for _ in range(W)]
        s.trail = [random.randint(max(6, H // 4), max(10, int(H * 0.9))) for _ in range(W)]
        s.glitch_until, s.next_glitch, s.bands = 0, time.time() + 2, []

    def step(s, dt, now):
        for x in range(s.W):
            s.head[x] += s.speed[x] * dt
            if s.head[x] - s.trail[x] > s.H:       # fell off the bottom: new drop after a delay
                s.head[x] = random.uniform(-s.H * 1.2, -2)
                s.speed[x] = random.uniform(8, 26)
                s.trail[x] = random.randint(max(6, s.H // 4), max(10, int(s.H * 0.9)))
        for _ in range(s.W * s.H // 60):           # random glyph flicker
            s.grid[random.randrange(s.H)][random.randrange(s.W)] = random.choice(GLYPHS)
        if now >= s.next_glitch:                   # glitch burst
            s.glitch_until = now + random.uniform(0.08, 0.28)
            s.next_glitch = now + random.uniform(1.2, 4.5)
            s.bands = [(random.randrange(s.H), random.randint(1, max(2, s.H // 8)),
                        random.choice([-1, 1]) * random.randint(2, max(3, s.W // 10)),
                        random.choice(GLITCH_COLS)) for _ in range(random.randint(2, 5))]

    def frame(s, now):
        H, W = s.H, s.W
        cells = [[(" ", None)] * W for _ in range(H)]
        for x in range(W):
            hx, tl = s.head[x], s.trail[x]
            y0, y1 = max(0, int(hx - tl)), min(H - 1, int(hx))
            for y in range(y0, y1 + 1):
                d = hx - y
                if d < 0 or d >= tl: continue
                if d < 1:
                    s.grid[y][x] = random.choice(GLYPHS)
                    col = HEAD
                else:
                    b = (1 - d / tl) ** 1.6
                    col = lerp(TRAIL_BOT, TRAIL_TOP, b)
                    col = lerp(BG, col, min(1, 0.25 + b * 1.2))
                cells[y][x] = (s.grid[y][x], col)
        if now < s.glitch_until:
            for y0, h, off, gc in s.bands:
                for y in range(y0, min(H, y0 + h)):
                    row = cells[y]
                    shifted = [row[(x - off) % W] for x in range(W)]
                    cells[y] = [(ch, gc if (ch != " " and random.random() < 0.55) else col) for ch, col in shifted]
                    for _ in range(W // 12):        # random bright glyphs
                        cells[y][random.randrange(W)] = (random.choice(GLYPHS), gc)
        return cells

def main():
    out, fd = sys.stdout, sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    stop = []
    for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sg, lambda *_: stop.append(1))
    tty.setcbreak(fd)
    out.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    rain, last, bg_seq = None, time.time(), "\x1b[48;2;%d;%d;%dm" % BG
    try:
        while not stop:
            if select.select([fd], [], [], 0)[0]:
                break
            W, H = os.get_terminal_size()
            if rain is None or (rain.W, rain.H) != (W, H):
                rain = Rain(W, H)
            now = time.time()
            rain.step(now - last, now); last = now
            cells = rain.frame(now)
            buf = ["\x1b[H", bg_seq]
            for y, row in enumerate(cells):
                prev = None
                for ch, col in row:
                    if col != prev:
                        buf.append("\x1b[38;2;%d;%d;%dm" % col if col else "")
                        prev = col
                    buf.append(ch)
                if y < H - 1: buf.append("\r\n")
            out.write("".join(buf)); out.flush()
            time.sleep(max(0, 1 / FPS - (time.time() - now)))
    finally:
        out.write("\x1b[0m\x1b[?25h\x1b[?1049l"); out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

if __name__ == "__main__":
    main()
