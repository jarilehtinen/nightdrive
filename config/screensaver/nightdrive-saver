#!/usr/bin/env python3
"""Nightdrive screensaver: a synthwave landscape in ASCII. No dependencies (truecolor ANSI).
Exits on any key or mouse movement."""
import re, math, os, random, select, signal, sys, termios, time, tty

GRACE = 1.0   # seconds after start when input is ignored (the window opening sends a mouse event)
MOUSE = re.compile(rb"\x1b\[<(\d+);(\d+);(\d+)[Mm]")   # SGR mouse report: button;column;row

def activity(data, pos):
    """A key, a click or scroll, or the pointer at a new position. A report at the same position isn't one: the terminal
    sends those when the pointer enters the window, e.g. when a notification over it goes away."""
    if MOUSE.sub(b"", data): return True
    for b, x, y in MOUSE.findall(data):
        if not int(b) & 32: return True                  # 32 = motion; anything else is a button or the wheel
        if pos[0] is not None and pos[0] != (x, y): return True
        pos[0] = (x, y)
    return False

FPS = 20
FULL_SKY = True      # True: sky fills the whole screen and the sun moves in an arc; False: sky + dot grid
DAY = 240.0          # sunrise→sunset takes this many seconds

def lerp(a, b, t): return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))
def mix(c, f): return tuple(min(255, int(v * f)) for v in c)

SKY_TOP, SKY_MID, SKY_LOW = (12, 4, 32), (58, 12, 96), (150, 30, 140)
FLOOR_BG = (14, 4, 30)
GRID_A, GRID_B = (255, 60, 220), (90, 220, 255)
MOUNTAIN, MOUNTAIN_EDGE = (28, 8, 58), (190, 70, 255)
SUN_TOP, SUN_BOT = (255, 230, 90), (255, 40, 150)

def main():
    out = sys.stdout
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    stop = []
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, lambda *_: stop.append(1))
    tty.setcbreak(fd)
    # ?1003/?1006: the terminal reports every mouse movement as input, so moving the mouse exits too. hypridle can't do it:
    # opening any window counts as activity, so its on-resume fired right away and closed the saver as it appeared.
    out.write("\x1b[?1049h\x1b[?25l\x1b[2J\x1b[?1003h\x1b[?1006h")
    started, pos = time.time(), [None]
    random.seed(84)
    stars = [(random.random(), random.random() ** 1.3, random.random() * 6.28, random.choice("·.+*")) for _ in range(140)]
    ridge_phase = [random.random() * 6.28 for _ in range(4)]
    t0 = time.time()
    try:
        while not stop:
            if select.select([fd], [], [], 0)[0]:
                data = os.read(fd, 1024)
                if time.time() - started > GRACE and activity(data, pos): break   # input in the first moment comes from the window opening
            W, H = os.get_terminal_size()
            t = time.time() - t0
            hz = H if FULL_SKY else int(H * 0.56)   # horizon
            cx = W / 2
            rows = [[(" ", None, FLOOR_BG)] * W for _ in range(H)]

            # sky
            for y in range(hz):
                f = y / max(1, hz - 1)
                bg = lerp(SKY_TOP, SKY_MID, f * 1.6) if f < 0.625 else lerp(SKY_MID, SKY_LOW, (f - 0.625) / 0.375)
                rows[y] = [(" ", None, bg)] * W
            # stars
            for sx, sy, ph, ch in stars:
                x, y = int(sx * W + t * 0.4) % W, int(sy * hz * 0.8)
                tw = 0.5 + 0.5 * math.sin(t * 1.7 + ph)
                if tw > 0.25 and y < hz:
                    rows[y][x] = (ch, mix((255, 220, 255), 0.35 + tw * 0.65), rows[y][x][2])

            # sun (stripes grow downwards and drift)
            if FULL_SKY:
                r = max(6, int(H * 0.3))
                p = (t / DAY) % 1.0
                scx = -2 * r + p * (W + 4 * r)
                scy = int(hz + r - math.sin(math.pi * p) * (hz * 0.78 + r))
            else:
                r = max(5, int(hz * 0.62))
                scy = hz - int(r * 0.35)
                scx = (t * 2.2) % (W + 4 * r + 8) - 2 * r - 4
            for y in range(scy - r, hz):
                dy = y - scy
                if y < 0 or abs(dy) > r: continue
                half = int(math.sqrt(r * r - dy * dy) * 2.0)
                f = (y - (scy - r)) / (2 * r)
                if f > 0.5:                          # cut-outs: fixed period, thickness grows downwards, creeps slowly
                    if (y - t * 0.25) % 4 < min(2.4, (f - 0.5) * 7): continue
                col = lerp(SUN_TOP, SUN_BOT, f)
                for x in range(max(0, int(scx) - half), min(W, int(scx) + half)):
                    rows[y][x] = (" ", None, col)

            # mountains (periodic silhouette, scrolls right)
            tau = 2 * math.pi
            for x in range(W):
                u = x / W - t * 0.007
                h = (0.5 + 0.5 * math.sin(tau * 2 * u + ridge_phase[0])) * 0.45 \
                  + (0.5 + 0.5 * math.sin(tau * 5 * u + ridge_phase[1])) * 0.3 \
                  + (0.5 + 0.5 * math.sin(tau * 11 * u + ridge_phase[2])) * 0.15
                h = int(h * hz * (0.3 if FULL_SKY else 0.38))
                for i in range(h):
                    y = hz - 1 - i
                    if i == h - 1: rows[y][x] = ("▄", MOUNTAIN_EDGE, MOUNTAIN)
                    else: rows[y][x] = (" ", None, MOUNTAIN)

            # floor + perspective grid
            fh = H - hz
            for y in range(hz, H):
                tt = (y - hz + 0.5) / fh              # 0..1 from the horizon down
                z = 1.0 / tt
                bg = lerp((40, 6, 70), FLOOR_BG, min(1, tt * 1.4))
                row = [(" ", None, bg)] * W
                glow = mix(lerp(GRID_B, GRID_A, min(1, tt * 1.5)), 0.3 + 0.5 * tt)
                # dot grid: intersections as dots, horizontal lines as dim dotted lines
                on_line = ((z * 0.9 - t * 0.9) % 1.0) < 0.09 + 0.04 * tt
                if on_line:
                    dim = mix(glow, 0.45)
                    for x in range(W % 2, W, 2): row[x] = ("·", dim, bg)
                    dot = "·" if tt < 0.35 else ("•" if tt < 0.75 else "●")
                    step = 10.0
                    pan = (t * 1.0) % step
                    for i in range(-40, 41):
                        x = int(cx + (i * step + pan) * tt * 2.0)
                        if 0 <= x < W: row[x] = (dot, glow, bg)
                rows[y] = row
            # horizon line
            if hz < H:
                rows[hz] = [("▀", (255, 110, 230), rows[hz][x][2]) for x in range(W)]

            # output (colour escapes only on change)
            buf = ["\x1b[H"]
            for y, row in enumerate(rows):
                last = None
                line = []
                for ch, fg, bg in row:
                    key = (fg, bg)
                    if key != last:
                        line.append("\x1b[48;2;%d;%d;%dm" % bg)
                        line.append("\x1b[38;2;%d;%d;%dm" % fg if fg else "")
                        last = key
                    line.append(ch)
                buf.append("".join(line) + "\x1b[0m")
                if y < H - 1: buf.append("\r\n")
            out.write("".join(buf)); out.flush()
            time.sleep(max(0, 1 / FPS - (time.time() - t0 - t)))
    finally:
        out.write("\x1b[?1003l\x1b[?1006l\x1b[0m\x1b[?25h\x1b[?1049l"); out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

if __name__ == "__main__":
    main()
