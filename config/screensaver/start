#!/bin/bash
# Launches the Nightdrive screensaver in a fullscreen kitty.
# Usage: start [saver|rain]  (picked at random without an argument)
pgrep -f '[n]ightdrive-(saver|rain)' >/dev/null && exit 0
dir=$(dirname "$(readlink -f "$0")")
case ${1:-} in
  saver|rain) name=$1 ;;
  *) name=$(shuf -n1 -e saver rain) ;;
esac
case $name in rain) size=18 ;; *) size=9 ;; esac   # rain: bigger glyphs
# The cursor is hidden by Hyprland while the saver runs: kitty's own hiding (mouse_hide_wait) doesn't apply once the
# program asks for mouse reports, which the savers do to exit on mouse movement
hyprctl eval 'hl.config({ cursor = { invisible = true } })' >/dev/null
trap "hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null" EXIT
kitty --class "nightdrive-$name" --start-as=fullscreen \
  -o window_padding_width=0 -o background=#09021e -o font_size=$size -o confirm_os_window_close=0 \
  python3 -I "$dir/nightdrive-$name"
