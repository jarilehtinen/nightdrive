#!/bin/bash
# The nightdrive command (linked to ~/.local/bin by link.sh). New subcommands go in the case at the bottom.
#   nightdrive update          pull Nightdrive (and a private overlay and Deck's source, if any), relink, install new
#                              packages, dnf upgrade, reload the desktop (launcher › Update runs this)
#   nightdrive update check    fetch only: how many new commits are waiting. Notifies once per new count, the notification's
#                              Update button runs the update in a terminal (nightdrive-update-check.timer, every 6 h)
#   nightdrive topbar adjust     top bar icon and text sizes / positions a pixel at a time, live (config/topbar/adjust.conf)
#   nightdrive theme|display|wallpaper|bar-style …   the desktop's own scripts (hypr/scripts), e.g. `nightdrive theme color teal`
# update never pulls over local changes: a repo with uncommitted work or its own commits is skipped with a note.
set -uo pipefail
repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
scripts="$repo/config/hypr/scripts"
cache="$HOME/.cache/nightdrive"
usage() { echo "Usage:"; sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//'; }

# Repos to update: Nightdrive, the repos the git-ignored local slots link into (a private overlay), Deck's source
repos() {
  echo "$repo"
  local f
  for f in "$repo"/config/hypr/local.d/* "$repo"/config/hypr/*.local* "$repo"/config/quickshell/local \
           "$repo"/config/topbar/local.* "$repo"/config/topbar/status.local; do
    [[ -L $f ]] && git -C "$(dirname "$(readlink -f "$f")")" rev-parse --show-toplevel 2>/dev/null
  done | sort -u
  [[ -d ${DECK_SRC:-$HOME/.local/src/deck}/.git ]] && readlink -f "${DECK_SRC:-$HOME/.local/src/deck}"
}
behind() { git -C "$1" rev-list --count HEAD..@{upstream} 2>/dev/null || echo 0; }

check() {
  total=0
  while read -r r; do
    timeout 30 git -C "$r" fetch -q 2>/dev/null || continue
    total=$(( total + $(behind "$r") ))
  done < <(repos | sort -u)
  mkdir -p "$cache"
  echo "$total" > "$cache/updates"
  last=$(cat "$cache/updates-notified" 2>/dev/null || echo 0)
  if (( total > 0 && total != last )); then
    echo "$total" > "$cache/updates-notified"
    (( total == 1 )) && what="1 new change" || what="$total new changes"
    action=$(notify-send -a Nightdrive -A update=Update "Nightdrive update" "$what waiting" 2>/dev/null)
    # systemd-run: its own unit, so the terminal outlives this oneshot service (whose processes systemd ends)
    [[ $action == update ]] && systemd-run --user --collect -q kitty --class floating-tui -e bash -c \
      '"$1" update; echo; read -rp "Done. Press Enter to close…"' _ "$repo/bin/nightdrive"
  fi
}

update() {
  relink=()
  deck=0
  while read -r r; do
    name=$(basename "$r")
    echo "==> $name"
    git -C "$r" fetch -q || { echo "    couldn't fetch, skipping"; continue; }
    n=$(behind "$r")
    if (( n == 0 )); then echo "    up to date"; continue; fi
    if [[ -n $(git -C "$r" status --porcelain --untracked-files=no) ]]; then
      echo "    $n new, but it has uncommitted changes: skipped (commit or stash them, then run this again)"; continue
    fi
    git -C "$r" --no-pager log --format='    %s' HEAD..@{upstream}
    git -C "$r" merge -q --ff-only @{upstream} || { echo "    has its own commits: skipped (rebase it by hand)"; continue; }
    if [[ $r == "$(readlink -f "${DECK_SRC:-$HOME/.local/src/deck}")" ]]; then deck=1
    elif [[ -x $r/link.sh ]]; then relink+=("$r"); fi
  done < <(repos | sort -u)

  # The overlay's link.sh after Nightdrive's, as on install
  for r in "${relink[@]}"; do echo "==> Links ($(basename "$r"))"; "$r/link.sh" | grep -v '^ok ' ; done

  echo "==> New packages"
  want=$(cat "$repo/packages.txt" "$repo/packages-hyprland.txt" 2>/dev/null | grep -vE '^\s*(#|$)')
  missing=$(for p in $want; do rpm -q --whatprovides "$p" >/dev/null 2>&1 || echo "$p"; done)
  if [[ -n $missing ]]; then echo "    $(echo $missing)"; sudo dnf install -y $missing; else echo "    none"; fi

  echo "==> System update"
  sudo dnf upgrade --refresh -y

  (( deck )) && { echo "==> Deck (rebuild)"; DECK_SRC=${DECK_SRC:-$HOME/.local/src/deck} "$repo/install-deck.sh"; }

  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    echo "==> Reloading the desktop"
    hyprctl reload >/dev/null
    "$repo/config/hypr/scripts/theme" apply >/dev/null 2>&1
    pkill -x waybar || true   # the old top bar (before Quickshell drew it); Quickshell reloads its own files
  fi

  mkdir -p "$cache"; echo 0 > "$cache/updates"; echo 0 > "$cache/updates-notified"
  echo
  echo "Nightdrive is up to date. If a change mentions install.sh, re-run it for that step (it's safe to re-run)."
}

case ${1:-} in
  update) if [[ ${2:-} == check ]]; then check; else update; fi ;;
  topbar) [[ ${2:-} == adjust ]] || { usage >&2; exit 1; }; exec "$repo/config/topbar/scripts/adjust" "${@:3}" ;;
  theme|display|wallpaper|bar-style) exec "$scripts/$1" "${@:2}" ;;
  ""|help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
